---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg';
  class?: string;
}
const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

const base =
  'inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-head font-semibold transition-all duration-200 hover:-translate-y-0.5';
const variants = {
  primary: 'bg-action text-on-action',
  ghost: 'border border-line text-fg hover:border-action hover:text-accent',
};
const sizes = {
  md: 'min-h-[44px] px-[26px] py-3.5 text-[15px]',
  lg: 'min-h-[52px] px-[34px] py-[18px] text-[16px]',
};
---
<a href={href} class:list={[base, variants[variant], sizes[size], className]}>
  <slot />
</a>

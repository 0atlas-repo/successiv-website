---
import { withBase } from '../base';
import { site } from '../content/site';
import Btn from './Btn.astro';
import ChatMock from './mocks/ChatMock.astro';
---

<section class="hero-wash relative overflow-hidden pb-[90px] pt-[104px]">
  <!-- Brand ribbon, kept from the previous site as a faint backdrop. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-[-8%] top-1/2 z-0 w-[min(46vw,620px)] -translate-y-1/2 opacity-[0.10] max-lg:opacity-[0.07]"
  >
    <div class="ribbon-bob">
      <img src={withBase("/img/logo-mark.svg")} alt="" class="ribbon-tilt block w-full" />
    </div>
  </div>

  <div class="relative z-[2] mx-auto max-w-[1180px] px-6">
    <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="reveal mb-[22px] font-head text-[13px] font-semibold uppercase tracking-[0.14em] text-accent">
          AI products · Business integration
        </p>
        <h1 class="reveal text-[clamp(38px,6vw,68px)] text-fg">
          Products that run<br />
          <span class="grad-text">the work.</span>
        </h1>
        <p class="reveal mt-[22px] max-w-[540px] text-[clamp(17px,2vw,19px)] text-fg-muted">
          {site.description}
        </p>
        <div class="reveal mt-9 flex flex-wrap gap-4">
          <Btn href={withBase("/products/")}>See products</Btn>
          <Btn href={withBase("/contact/")} variant="ghost">Talk to us</Btn>
        </div>
      </div>

      <!-- A real product screen, hand-built. Sets the tone before any copy about it. -->
      <div class="reveal relative max-lg:mx-auto max-lg:max-w-[420px]">
        <div class="mock-wash pointer-events-none absolute -inset-10" aria-hidden="true"></div>
        <div class="relative lg:rotate-[1.2deg]">
          <ChatMock />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ribbon-bob { animation: ribbon-bob 10.05s ease-in-out infinite; }
  .ribbon-tilt { animation: ribbon-tilt 13.82s ease-in-out infinite; }

  @keyframes ribbon-bob {
    0%, 100% { transform: translateY(0); }
    25% { transform: translateY(3.5%); }
    75% { transform: translateY(-3.5%); }
  }
  @keyframes ribbon-tilt {
    0%, 100% { transform: rotate(0deg); }
    25% { transform: rotate(2deg); }
    75% { transform: rotate(-2deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ribbon-bob, .ribbon-tilt { animation: none; }
  }
</style>

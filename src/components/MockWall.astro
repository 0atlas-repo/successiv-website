---
// The home hero: a wall of mocked screens behind the headline. Every card is a
// screen already drawn for a product or work page, captioned with that entry
// and the step it shows, and linked to that page — so the wall shows how much
// we have built without inventing anything. No screen appears twice.
//
// Columns scroll in a loop, odd columns down and even columns up; hovering or
// focusing inside a column pauses it. Each column renders its cards twice so
// the loop is seamless; the copy is hidden from assistive tech and the tab
// order. Each screen plays its own steps as it fades in, then one on-screen
// card at a time replays, so the wall keeps moving without every screen
// animating at once.
import { withBase } from '../base';
import { site } from '../content/site';
import { products } from '../content/products';
import { work } from '../content/work';
import Btn from './Btn.astro';
import ProductMock from './mocks/ProductMock.astro';
import WorkMock from './mocks/WorkMock.astro';
import { phoneScreens } from './mocks/phoneScreens';

// `isStep`: the caption is a step title, not the entry's fallback category.
type Card = { entry: string; kind: string; caption: string; isStep: boolean; href: string; mock: string; isProduct: boolean };
// A tile is one card, or two phone screens from the same app side by side, so
// a phone does not sit alone in a tile drawn for a desktop window.
type Tile = { entry: string; kind: string; href: string; isProduct: boolean; screens: Card[] };

// Each entry's screens, step screens first so each carries its step title.
const perEntry: Card[][] = [
  ...products.map((p) => {
    const seen = new Set<string>();
    const fromSteps = p.steps.filter((s) => s.screen).map((s) => ({ mock: s.screen!, caption: s.title, isStep: true }));
    const fromScreens = p.screens.map((m) => ({ mock: m, caption: p.category, isStep: false }));
    return [...fromSteps, ...fromScreens]
      .filter((c) => c.mock !== 'generic' && !seen.has(c.mock) && seen.add(c.mock))
      .map((c) => ({ ...c, entry: p.name, kind: 'Product', href: `/products/${p.slug}/`, isProduct: true }));
  }),
  ...work.map((w) => {
    const seen = new Set<string>();
    const fromSteps = (w.steps ?? []).map((s) => ({ mock: s.screen, caption: s.title, isStep: true }));
    const fromScreens = w.screens.map((m) => ({ mock: m, caption: w.angle, isStep: false }));
    return [...fromSteps, ...fromScreens]
      .filter((c) => !seen.has(c.mock) && seen.add(c.mock))
      .map((c) => ({ ...c, entry: w.title, kind: 'Client build', href: `/work/${w.slug}/`, isProduct: false }));
  }),
];

// Every phone tile holds two phone screens of one entry, in that entry's order,
// placed where the first of the two stood (founder, 2026-09-28). An entry with
// an odd number leaves its last phone screen off the wall: pairing it with
// another app's would mislabel the tile, and a lone phone is what the pairs
// replace. It still shows on its own page.
const perEntryTiles: Tile[][] = perEntry.map((list) => {
  const phones = list.filter((c) => phoneScreens.has(c.mock));
  const partner = new Map<Card, Card | null>();
  for (let i = 0; i < phones.length; i += 2) {
    partner.set(phones[i], phones[i + 1] ?? null);
    if (phones[i + 1]) partner.set(phones[i + 1], null);
  }
  const tiles: Tile[] = [];
  for (const c of list) {
    const tile = { entry: c.entry, kind: c.kind, href: c.href, isProduct: c.isProduct };
    if (!phoneScreens.has(c.mock)) tiles.push({ ...tile, screens: [c] });
    else if (partner.get(c)) tiles.push({ ...tile, screens: [c, partner.get(c)!] });
  }
  return tiles;
});

// Round-robin across entries so neighbouring tiles come from different
// projects, until the wall holds SCREENS screens (a pair counts as two).
// Seven columns: the middle five plus one more on each side, which a normal
// screen crops, so the wall runs off both edges at any width up to ~3,100px
// (founder, 2026-09-29). SCREENS keeps about five tiles in each column.
const COLS = 7;
const SCREENS = 40;
const tiles: Tile[] = [];
let screenCount = 0;
for (let round = 0; screenCount < SCREENS; round++) {
  const before = tiles.length;
  for (const list of perEntryTiles) {
    const t = list[round];
    if (t && screenCount < SCREENS) { tiles.push(t); screenCount += t.screens.length; }
  }
  if (tiles.length === before) break;
}
// A pair's caption lists its step titles; the entry's fallback category only
// shows when neither screen is a step.
// Each part keeps its screen's index, so a phone can hide the second screen of
// a pair together with its title.
const captionFor = (t: Tile) => {
  const steps = t.screens.map((s, i) => ({ i, text: s.caption, isStep: s.isStep })).filter((s) => s.isStep);
  return steps.length ? steps : [{ i: 0, text: t.screens[0].caption }];
};
const columns = Array.from({ length: COLS }, (_, c) => tiles.filter((_, i) => i % COLS === c));
const entryCount = perEntry.filter((l) => l.length).length;
---

<section class="wall relative isolate overflow-hidden">
  <div class="wall-stage" aria-label={`Screens from ${entryCount} things we have built`}>
    {columns.map((col, c) => (
      <div class="wall-col" style={`--c:${c}`}>
        <div class="wall-drift">
          {[false, true].map((copy) => (
          <div class="wall-set" aria-hidden={copy ? 'true' : undefined} inert={copy}>
          {col.map((tile) => (
            <a
              href={withBase(tile.href)}
              class="wall-card reveal"
              data-tile={tile.screens.length === 2 ? 'pair' : undefined}
            >
              <div class="wall-shot" aria-hidden="true">
                <div class={tile.screens.length === 2 ? 'wall-pair' : undefined}>
                  {tile.screens.map((s) => (
                    <div class:list={['wall-zoom', tile.screens.length === 2 && 'wall-zoom-phone']}>
                      {s.isProduct ? <ProductMock mock={s.mock as any} /> : <WorkMock mock={s.mock as any} />}
                    </div>
                  ))}
                </div>
              </div>
              <span class="mt-2.5 block font-mono text-[12.5px] font-semibold text-fg">{tile.entry}</span>
              <span class="block font-mono text-[11.5px] text-fg-subtle">{tile.kind} · {captionFor(tile).map((c, n) => (
                <span class:list={[c.i > 0 && 'wall-cap-2']}>{n > 0 ? ' · ' : ''}{c.text}</span>
              ))}</span>
            </a>
          ))}
          </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="wall-fade pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>

  <div class="wall-copy absolute inset-x-0 bottom-0 z-[2] pb-14">
    <div class="mx-auto grid max-w-[1180px] items-end gap-8 px-6 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div>
        <h1 class="text-[clamp(38px,6vw,64px)] text-fg">
          Software that runs<br />
          <span class="grad-text">the work.</span>
        </h1>
      </div>
      <div>
        <p class="max-w-[440px] text-[16px] text-fg-muted">{site.description}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Btn href={withBase('/products/')}>See products</Btn>
          <Btn href={withBase('/work/')} variant="ghost">Browse the work</Btn>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wall {
    /* Tile width, unitless so the zooms below can divide by it. Wide enough
       for a desktop window to read as one (founder, 2026-09-28). */
    --card-n: 420;
    --gap: 34px;
    /* Fill the first screen under the sticky header. */
    height: max(680px, calc(100svh - 77px));
    background: var(--color-bg);
  }
  .wall-stage {
    position: absolute;
    z-index: 0; /* contains mock chrome's own z-index under the fade */
    inset: -4% 0 0 50%;
    translate: -50% 0;
    display: flex;
    gap: var(--gap);
    width: max-content;
  }
  .wall-col { width: calc(var(--card-n) * 1px); }
  /* Two identical sets, each with its gap at the bottom, so -50% is exactly one
     set and the loop has no seam. The negative delay staggers the columns so no
     row of cards lines up. Half the first cut's speed (founder, 2026-09-28). */
  .wall-drift {
    animation: wall-loop calc(128s + var(--c) * 14s) linear infinite;
    animation-delay: calc(var(--c) * -26s);
  }
  .wall-col:nth-child(odd) .wall-drift { animation-direction: reverse; }
  .wall-col:hover .wall-drift,
  .wall-col:focus-within .wall-drift { animation-play-state: paused; }
  .wall-set {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-bottom: 44px;
  }
  @keyframes wall-loop {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  /* Cards fade in through .reveal, which also starts each screen's steps. */
  .wall-card { display: block; }

  .wall-shot {
    height: 260px;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 14px 14px 0;
    transition: transform 400ms var(--ease-brand), border-color 300ms;
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
    mask-image: linear-gradient(to bottom, #000 78%, transparent);
  }
  /* A desktop window shows whole, at its own landscape height; two phones side
     by side get a taller tile. */
  .wall-shot:has(.mock-desktop) { height: auto; max-height: 330px; padding-bottom: 14px; }
  .wall-card[data-tile='pair'] .wall-shot { height: 300px; }
  .wall-pair { display: flex; justify-content: center; gap: 12px; }
  .wall-card:hover .wall-shot,
  .wall-card:focus-visible .wall-shot {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-action) 45%, transparent);
  }
  /* Mocks are drawn for a ~440px column; shrink the whole screen to the tile
     (its width less 28px of padding), not its text. A paired phone is drawn
     272px wide and gets half the tile, less the 12px between the two. */
  .wall-zoom { width: 440px; zoom: calc((var(--card-n) - 28) / 440); }
  .wall-zoom-phone { width: 272px; zoom: calc((var(--card-n) - 40) / 2 / 272); }

  .wall-fade {
    background:
      linear-gradient(to top, var(--color-bg) 0%, var(--color-bg) 30%, color-mix(in srgb, var(--color-bg) 80%, transparent) 42%, transparent 70%),
      linear-gradient(to bottom, var(--color-bg) 0%, transparent 14%),
      radial-gradient(ellipse at 50% 40%, transparent 55%, color-mix(in srgb, var(--color-bg) 70%, transparent) 100%);
  }

  @media (max-width: 767px) {
    /* A phone gets 340px tiles, near its full width, so a desktop window
       still reads as one; and a phone tile shows one phone, not a pair, at
       its drawn size. The second screen's title hides with it (founder,
       2026-09-29). */
    .wall { --card-n: 340; --gap: 20px; }
    .wall-shot { height: 200px; }
    .wall-shot:has(.mock-desktop) { max-height: 260px; }
    .wall-card[data-tile='pair'] .wall-shot { height: 250px; }
    .wall-card[data-tile='pair'] .wall-zoom-phone:nth-child(n + 2),
    .wall-cap-2 { display: none; }
    .wall-zoom-phone { zoom: 1; }
    /* On a phone the copy is taller than the faded part of a fixed-height
       hero, so the headline rode up over the cards. Instead the hero grows to
       its copy, the copy starts 280px down under a band of wall, and it
       carries its own backdrop that fades in 80px above it (founder,
       2026-09-28: "title should move a bit lower"). */
    .wall { height: auto; }
    .wall-copy { position: relative; padding-top: 280px; }
    .wall-copy::before {
      content: '';
      position: absolute;
      inset: 200px 0 0 0;
      z-index: -1;
      background: linear-gradient(to bottom, transparent, var(--color-bg) 80px);
    }
    .wall-fade { background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 14%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall-drift { animation: none; }
  }
</style>

<script>
  // Replay one on-screen card's steps at a time. Cards in the bottom third sit
  // under the fade, so they are skipped.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.wall').forEach((wall) => {
      const cards = [...wall.querySelectorAll<HTMLElement>('.wall-card')];
      let last = -1;
      setInterval(() => {
        const h = wall.getBoundingClientRect();
        if (document.hidden || h.bottom < 0) return;
        const visible = cards.filter((c, i) => {
          const r = c.getBoundingClientRect();
          return i !== last && r.bottom > h.top && r.top < h.bottom - h.height * 0.35 && r.right > 0 && r.left < innerWidth;
        });
        if (!visible.length) return;
        const card = visible[Math.floor(Math.random() * visible.length)];
        last = cards.indexOf(card);
        card.querySelectorAll<HTMLElement>('.mock-step, .mock-before').forEach((el) => {
          el.style.animation = 'none';
          void el.offsetWidth;
          el.style.animation = '';
        });
      }, 1800);
    });
  }
</script>

---
// The home hero: a wall of mocked screens behind the headline. Every card is a
// screen already drawn for a product or work page, captioned with that entry
// and the step it shows, and linked to that page — so the wall shows how much
// we have built without inventing anything. No screen appears twice.
//
// The column count follows the screen (--n below: 2 on a phone up to 5 on a
// wide desktop) so every column is whole; a small inline script deals the same
// 25 cards across that many columns. Columns scroll in a loop, odd columns down
// and even columns up; hovering or focusing inside a column pauses it. Each column renders its cards twice so
// the loop is seamless; the copy is hidden from assistive tech and the tab
// order. Each screen plays its own steps as it fades in, then one on-screen
// card at a time replays, so the wall keeps moving without every screen
// animating at once.
import { withBase } from '../base';
import { site } from '../content/site';
import { products } from '../content/products';
import { work } from '../content/work';
import Btn from './Btn.astro';
import ProductMock from './mocks/ProductMock.astro';
import WorkMock from './mocks/WorkMock.astro';

type Card = { entry: string; kind: string; caption: string; href: string; mock: string; isProduct: boolean };

// Each entry's screens, step screens first so each carries its step title.
const perEntry: Card[][] = [
  ...products.map((p) => {
    const seen = new Set<string>();
    const fromSteps = p.steps.filter((s) => s.screen).map((s) => ({ mock: s.screen!, caption: s.title }));
    const fromScreens = p.screens.map((m) => ({ mock: m, caption: p.category }));
    return [...fromSteps, ...fromScreens]
      .filter((c) => c.mock !== 'generic' && !seen.has(c.mock) && seen.add(c.mock))
      .map((c) => ({ ...c, entry: p.name, kind: 'Product', href: `/products/${p.slug}/`, isProduct: true }));
  }),
  ...work.map((w) => {
    const seen = new Set<string>();
    const fromSteps = (w.steps ?? []).map((s) => ({ mock: s.screen, caption: s.title }));
    const fromScreens = w.screens.map((m) => ({ mock: m, caption: w.angle }));
    return [...fromSteps, ...fromScreens]
      .filter((c) => !seen.has(c.mock) && seen.add(c.mock))
      .map((c) => ({ ...c, entry: w.title, kind: 'Client build', href: `/work/${w.slug}/`, isProduct: false }));
  }),
];

// Round-robin across entries so neighbouring cards come from different projects.
const COLS = 5;
const PER_COL = 5;
const cards: Card[] = [];
for (let round = 0; cards.length < COLS * PER_COL; round++) {
  const before = cards.length;
  for (const list of perEntry) if (list[round] && cards.length < COLS * PER_COL) cards.push(list[round]);
  if (cards.length === before) break;
}
// Server-rendered at five columns; the script re-deals by data-i for smaller screens.
const columns = Array.from({ length: COLS }, (_, c) => cards.map((card, i) => ({ card, i })).filter(({ i }) => i % COLS === c));
const entryCount = perEntry.filter((l) => l.length).length;
---

<section class="wall relative isolate overflow-hidden">
  <div class="wall-stage" aria-label={`Screens from ${entryCount} things we have built`}>
    {columns.map((col, c) => (
      <div class="wall-col" style={`--c:${c}`}>
        <div class="wall-drift">
          {[false, true].map((copy) => (
          <div class="wall-set" aria-hidden={copy ? 'true' : undefined} inert={copy}>
          {col.map(({ card, i }) => (
            <a
              href={withBase(card.href)}
              class="wall-card reveal"
              data-i={i}
            >
              <div class="wall-shot" aria-hidden="true">
                <div class="wall-zoom">
                  {card.isProduct ? <ProductMock mock={card.mock as any} /> : <WorkMock mock={card.mock as any} />}
                </div>
              </div>
              <span class="mt-2.5 block font-mono text-[12.5px] font-semibold text-fg">{card.entry}</span>
              <span class="block font-mono text-[11.5px] text-fg-subtle">{card.kind} · {card.caption}</span>
            </a>
          ))}
          </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="wall-fade pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>

  <div class="wall-copy absolute inset-x-0 bottom-0 z-[2] pb-8 sm:pb-14">
    <div class="mx-auto grid max-w-[1180px] items-end gap-5 px-6 sm:gap-8 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="mb-4 sm:mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3.5 py-1.5 text-[13px] text-fg-muted backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          {cards.length} screens from {entryCount} things we have built
        </p>
        <h1 class="text-[clamp(32px,6vw,64px)] text-fg">
          Software that runs<br />
          <span class="grad-text">the work.</span>
        </h1>
      </div>
      <div>
        <p class="max-w-[440px] text-[16px] text-fg-muted">{site.description}</p>
        <div class="mt-5 flex flex-wrap gap-3 sm:mt-6">
          <Btn href={withBase('/products/')} class="max-sm:px-5">See products</Btn>
          <Btn href={withBase('/work/')} variant="ghost" class="max-sm:px-5">Browse the work</Btn>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Columns per screen width. The script reads --n, so change it here only. */
  .wall {
    --n: 2;
    --gap: 16px;
    --pad: 16px;
    /* Fill the first screen under the sticky header. The phone floor fits a
       667px-tall screen, so both buttons show without scrolling. */
    height: max(560px, calc(100svh - 77px));
    background: var(--color-bg);
  }
  @media (min-width: 640px) { .wall { --n: 3; --gap: 24px; --pad: 24px; height: max(680px, calc(100svh - 77px)); } }
  @media (min-width: 1024px) { .wall { --n: 4; --gap: 28px; } }
  @media (min-width: 1440px) { .wall { --n: 5; --gap: 34px; } }
  .wall-stage {
    position: absolute;
    z-index: 0; /* contains mock chrome's own z-index under the fade */
    inset: -4% 0 0 0;
    margin-inline: auto;
    /* Cap cards at 320px so a very wide screen centres the wall. */
    max-width: calc(var(--n) * 320px + (var(--n) - 1) * var(--gap) + 2 * var(--pad));
    padding-inline: var(--pad);
    display: flex;
    gap: var(--gap);
  }
  .wall-col { flex: 1 1 0; min-width: 0; }
  /* Before the script runs (or without it), show only as many columns as fit. */
  .wall-col:nth-child(n + 3) { display: none; }
  @media (min-width: 640px) { .wall-col:nth-child(n + 3) { display: block; } .wall-col:nth-child(n + 4) { display: none; } }
  @media (min-width: 1024px) { .wall-col:nth-child(n + 4) { display: block; } .wall-col:nth-child(n + 5) { display: none; } }
  @media (min-width: 1440px) { .wall-col:nth-child(n + 5) { display: block; } }
  /* Two identical sets, each with its gap at the bottom, so -50% is exactly one
     set and the loop has no seam. The script sets --len (one set's height in
     px) and --v (the column's speed in px/s), so every width moves at the same
     on-screen speed: about 15px/s on average, 30% slower than the first cut's
     21px/s (founder, 2026-09-28). The negative delay staggers the columns so no
     row of cards lines up. */
  .wall-drift {
    animation: wall-loop calc(var(--len, 1600) * 1s / var(--v, 15)) linear infinite;
    animation-delay: calc(var(--c) * -13s);
  }
  .wall-col:nth-child(odd) .wall-drift { animation-direction: reverse; }
  .wall-col:hover .wall-drift,
  .wall-col:focus-within .wall-drift { animation-play-state: paused; }
  .wall-set {
    display: flex;
    flex-direction: column;
    gap: 44px;
    padding-bottom: 44px;
  }
  @keyframes wall-loop {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  /* Cards fade in through .reveal, which also starts each screen's steps. */
  .wall-card { display: block; }

  .wall-shot {
    height: 220px;
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 14px 14px 0;
    transition: transform 400ms var(--ease-brand), border-color 300ms;
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
    mask-image: linear-gradient(to bottom, #000 78%, transparent);
  }
  .wall-card:nth-child(3n + 2) .wall-shot { height: 280px; }
  .wall-card:nth-child(3n) .wall-shot { height: 180px; }
  .wall-card:hover .wall-shot,
  .wall-card:focus-visible .wall-shot {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-action) 45%, transparent);
  }
  /* Mocks are drawn for a ~440px column; shrink the whole screen, not its text.
     The script sets --zoom from the card's real width. */
  .wall-zoom { width: 440px; zoom: var(--zoom, 0.5); }

  .wall-fade {
    background:
      linear-gradient(to top, var(--color-bg) 0%, var(--color-bg) 30%, color-mix(in srgb, var(--color-bg) 80%, transparent) 42%, transparent 70%),
      linear-gradient(to bottom, var(--color-bg) 0%, transparent 14%),
      radial-gradient(ellipse at 50% 40%, transparent 55%, color-mix(in srgb, var(--color-bg) 70%, transparent) 100%);
  }

  /* The copy carries its own backdrop, solid behind the text and fading out
     140px above it, so no card caption shows through the paragraph at any
     width. */
  .wall-copy::before {
    content: '';
    position: absolute;
    inset: -140px 0 0 0;
    z-index: -1;
    background: linear-gradient(to top, var(--color-bg) calc(100% - 140px), transparent);
  }

  @media (max-width: 767px) {
    .wall-shot { height: 170px; }
    .wall-card:nth-child(3n + 2) .wall-shot { height: 210px; }
    .wall-card:nth-child(3n) .wall-shot { height: 140px; }
    /* The copy's backdrop covers the bottom; only the top edge fades here. */
    .wall-fade { background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 14%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wall-drift { animation: none; }
  }
</style>

<script is:inline>
  // Deal the cards across as many columns as the screen fits (--n in the CSS
  // above), keeping the server's round-robin order by data-i, and give each
  // column a hidden, inert copy for the seamless loop. Inline, so the first
  // paint already has the right columns and the reveal observer (bound later,
  // in Layout) sees every card. New shells are blank clones of the server's, so
  // they keep Astro's scoping attribute and with it their styles.
  document.querySelectorAll('.wall').forEach((wall) => {
    const stage = wall.querySelector('.wall-stage');
    const blank = (sel) => stage.querySelector(sel).cloneNode(false);
    const shells = { col: blank('.wall-col'), drift: blank('.wall-drift'), set: blank('.wall-set:not([inert])') };
    const cards = [...stage.querySelectorAll('.wall-set:not([inert]) .wall-card')].sort((a, b) => a.dataset.i - b.dataset.i);
    let n = 0;
    let dealt = false;
    const layout = () => {
      const want = parseInt(getComputedStyle(wall).getPropertyValue('--n'), 10);
      if (want && want !== n) {
        n = want;
        stage.replaceChildren(...Array.from({ length: n }, (_, c) => {
          const col = shells.col.cloneNode(false);
          const drift = shells.drift.cloneNode(false);
          const set = shells.set.cloneNode(false);
          const mine = cards.filter((_, i) => i % n === c);
          col.style.setProperty('--c', c);
          // Speeds step 13.8 / 15 / 16.2 px/s so neighbours drift apart.
          col.style.setProperty('--v', 15 * (1 + ((c % 3) - 1) * 0.08));
          set.append(...mine);
          const copy = set.cloneNode(true);
          copy.inert = true;
          copy.setAttribute('aria-hidden', 'true');
          drift.append(set, copy);
          col.append(drift);
          return col;
        }));
        // A moved card drops out of the reveal observer, so after first load
        // show every card outright rather than leave some faded.
        if (dealt) stage.querySelectorAll('.wall-card').forEach((el) => el.classList.add('is-visible'));
        dealt = true;
      }
      const shot = stage.querySelector('.wall-shot');
      if (shot) wall.style.setProperty('--zoom', ((shot.clientWidth - 28) / 440).toFixed(4));
      // Zoom sets the card heights, so measure the loop length after it.
      stage.querySelectorAll('.wall-col').forEach((col) => {
        col.style.setProperty('--len', col.querySelector('.wall-set').offsetHeight);
      });
    };
    layout();
    addEventListener('resize', layout);
  });
</script>

<script>
  // Replay one on-screen card's steps at a time. Cards in the bottom third sit
  // under the fade, so they are skipped.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.wall').forEach((wall) => {
      let last: HTMLElement | null = null;
      setInterval(() => {
        // Looked up each tick: a resize re-deals the columns and replaces the copies.
        const cards = [...wall.querySelectorAll<HTMLElement>('.wall-card')];
        const h = wall.getBoundingClientRect();
        if (document.hidden || h.bottom < 0) return;
        const visible = cards.filter((c) => {
          const r = c.getBoundingClientRect();
          return c !== last && r.bottom > h.top && r.top < h.bottom - h.height * 0.35 && r.right > 0 && r.left < innerWidth;
        });
        if (!visible.length) return;
        const card = visible[Math.floor(Math.random() * visible.length)];
        last = card;
        card.querySelectorAll<HTMLElement>('.mock-step, .mock-before').forEach((el) => {
          el.style.animation = 'none';
          void el.offsetWidth;
          el.style.animation = '';
        });
      }, 1800);
    });
  }
</script>

---
import { site } from '../content/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-[1180px] px-6 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <a href="/" aria-label={`${site.name} home`} class="flex items-center gap-2.5">
          <img src="/img/logo-mark.svg" alt="" width="28" height="21" class="h-[21px] w-auto" />
          <img src="/img/logo-wordmark-white.svg" alt={site.name} data-logo="light" class="h-3.5 w-auto" />
          <img src="/img/logo-wordmark-ink.svg" alt={site.name} data-logo="dark" class="h-3.5 w-auto" />
        </a>
        <p class="mt-4 max-w-[320px] font-head text-[15px] text-fg-muted">
          {site.legacyTagline}
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-wrap gap-x-8 gap-y-3">
        {site.nav.map((item) => (
          <a href={item.href} class="font-head text-sm font-medium text-fg-muted transition-colors duration-200 hover:text-fg">
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-line pt-6 text-[13px] text-fg-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>
        Product brand of{' '}
        <a href={site.parent.url} class="text-fg-muted underline underline-offset-4 transition-colors hover:text-fg">
          {site.parent.name}
        </a>
      </p>
    </div>
  </div>
</footer>

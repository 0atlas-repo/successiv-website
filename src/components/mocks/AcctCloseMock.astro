---
import MockFrame from './MockFrame.astro';
const periods = [
  { label: 'Jan 2026', closed: true },
  { label: 'Feb 2026', closed: true },
  { label: 'Mar 2026', closed: false },
];
---
<MockFrame title="Bookkeeping — Period close" meta="2 locked">
  <div class="space-y-2">
    <div class="space-y-1.5">
      {periods.map((p) => (
        <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/40 px-2.5 py-2">
          <span class:list={['flex-1 truncate text-[10.5px]', p.closed ? 'text-fg-muted' : 'font-medium text-fg']}>{p.label}</span>
          {p.closed ? (
            <span class="flex shrink-0 items-center gap-1">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-fg-subtle" aria-hidden="true">
                <rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              <span class="font-head text-[9px] uppercase tracking-[0.08em] text-fg-subtle">Closed</span>
            </span>
          ) : (
            <span class="shrink-0 rounded-full border border-line px-2 py-0.5 font-head text-[9px] uppercase tracking-[0.08em] text-action">Open</span>
          )}
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2 border-t border-line pt-2">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span class="text-[10px] text-fg-subtle">A closed period accepts reversals only.</span>
    </div>
  </div>
</MockFrame>

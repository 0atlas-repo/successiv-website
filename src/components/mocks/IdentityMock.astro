---
import MockFrame from './MockFrame.astro';
// These are documents a holder keeps, and their verification state — NOT
// automated checks. This product has no face match, no liveness test and no
// text recognition, and the page says so plainly, so the "Face match · Pass"
// row this mock used to carry contradicted its own page.
const checks = [
  { label: 'Passport', state: 'pass' },
  { label: 'Phone · verified by code', state: 'pass' },
  { label: 'Proof of address', state: 'review' },
  { label: 'Email', state: 'review' },
];
---
<MockFrame title="Identity — Documents" meta="Held">
  <div class="space-y-3">
    <div class="flex items-center gap-2.5">
      <div class="h-10 w-10 shrink-0 rounded-full bg-fg-subtle/20"></div>
      <div class="min-w-0">
        <div class="font-head text-[12px] font-medium text-fg">Holder</div>
        <div class="text-[10.5px] text-fg-subtle">4 documents held</div>
      </div>
      <span class="ml-auto shrink-0 rounded-full border border-line px-2 py-1 font-head text-[9.5px] uppercase tracking-[0.08em] text-fg-subtle">
        2 pending
      </span>
    </div>

    <div class="space-y-1.5">
      {checks.map((c) => (
        <div class="flex items-center gap-2 rounded-lg border border-line bg-surface px-2.5 py-1.5">
          {c.state === 'pass' ? (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-action" aria-hidden="true">
              <path d="m20 6-11 11-5-5" />
            </svg>
          ) : (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
            </svg>
          )}
          <span class="flex-1 truncate text-[12px] text-fg">{c.label}</span>
          <span class="shrink-0 font-head text-[9.5px] uppercase tracking-[0.08em] text-fg-subtle">
            {c.state === 'pass' ? 'Verified' : 'Pending'}
          </span>
        </div>
      ))}
    </div>

    <div class="flex gap-2 border-t border-line pt-2.5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action">Share</span>
      <span class="flex-1 rounded-full border border-line py-1.5 text-center font-head text-[10.5px] font-semibold text-fg-muted">Add document</span>
    </div>
  </div>
</MockFrame>

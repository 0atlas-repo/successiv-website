---
import MockFrame from './MockFrame.astro';
// These are documents a holder keeps, and their verification state. There is
// no automated identity check behind any of this — a person reviews each
// document, and contact details confirm themselves by one-time code.
const checks = [
  { label: 'Passport', kind: 'doc', state: 'pass' },
  { label: 'ID card', kind: 'doc', state: 'pass' },
  { label: 'Proof of address', kind: 'doc', state: 'review', selected: true },
  { label: 'Phone · verified by code', kind: 'phone', state: 'pass' },
  { label: 'Email · verify by code', kind: 'mail', state: 'review' },
];
---
<MockFrame chrome="tabs" title="Identity — Documents" meta="Held">
  <div class="space-y-3">
    <div class="flex items-center gap-2.5">
      <div class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-fg-subtle/15 text-fg-subtle ring-1 ring-line">
        <span class="font-head text-[12px] font-semibold">JD</span>
      </div>
      <div class="min-w-0">
        <div class="font-head text-[12px] font-medium text-fg">Holder</div>
        <div class="text-[10.5px] tabular-nums text-fg-subtle">5 documents held</div>
      </div>
      <span class="ml-auto shrink-0 whitespace-nowrap rounded-full bg-warn-soft px-2 py-1 font-head text-[9.5px] uppercase tracking-[0.08em] tabular-nums text-warn">
        2 pending
      </span>
    </div>

    <div class="space-y-1.5">
      {checks.map((c) => (
        <div
          class:list={[
            'flex items-center gap-2.5 rounded-lg border px-2.5 py-1.5',
            c.selected ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
          ]}
        >
          {c.kind === 'phone' ? (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
            </svg>
          ) : c.kind === 'mail' ? (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          ) : (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" />
            </svg>
          )}
          <span class="min-w-0 flex-1 truncate text-[12px] text-fg">{c.label}</span>
          <span
            class:list={[
              'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
              c.state === 'pass' ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn',
            ]}
          >
            {c.state === 'pass' ? 'Verified' : 'Pending'}
          </span>
        </div>
      ))}
    </div>

    <div class="flex gap-2 border-t border-line pt-2.5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action">Share</span>
      <span class="flex-1 rounded-full border border-line py-1.5 text-center font-head text-[10.5px] font-semibold text-fg-muted">Add document</span>
    </div>
  </div>
</MockFrame>

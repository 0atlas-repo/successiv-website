---
import MockFrame from './MockFrame.astro';
// The assistant: input placeholder "Enter a question" is the app's own (the
// app, pages/Chatbot/View.tsx:1780); the loading line is quoted from the
// app's own copy, "Loading to gather sources, compile data, and consolidate
// the response ..." (the app, pages/Chatbot/Message.tsx:463). An answer can
// carry a "Source:" block with a title and a link (the app,
// pages/Chatbot/MessageReferences.tsx:9-30) — a plain title and link, not
// the clause-number-and-page-number citation card an earlier version of
// this screen invented; corrected here to match what the app actually
// shows. Thumbs up/down opens a reason dialog in the real app (the app,
// pages/Chatbot/FeedbackDialog.tsx); only the two buttons are drawn.
// Question and answer text are fictional examples in the app's own
// plain-question format, continuing the CN-104 example from the earlier
// steps on this page.
// Source: research note "contract-lifecycle", "5. Chatbot" and
// "Recommended steps" step 4.
---
<MockFrame title="Contracts — Ask" meta="CN-104">
  <div class="space-y-2.5">
    <div class="flex justify-end">
      <p class="mock-step max-w-[85%] rounded-2xl rounded-br-sm bg-action px-3 py-2 text-[12px] leading-snug text-on-action" style="--step: 0">
        Does the current variation need approval before the certificate is raised?
      </p>
    </div>

    <div class="mock-step flex justify-start" style="--step: 1">
      <div class="max-w-[85%] rounded-2xl rounded-bl-sm border border-line bg-surface px-3 py-2">
        <div class="grid">
          <p class="mock-before col-start-1 row-start-1 text-[10.5px] leading-snug text-fg-subtle" style="--swap: 2">Loading to gather sources, compile data, and consolidate the response ...</p>
          <p class="mock-step col-start-1 row-start-1 text-[12px] leading-snug text-fg" style="--step: 2">Yes — a variation needs sign-off before a certificate can reference it.</p>
        </div>
      </div>
    </div>

    <div class="mock-step flex items-center gap-1.5 pl-1 text-[10.5px] text-fg-subtle" style="--step: 3">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      Source: <span class="text-fg">Variations clause</span>
    </div>

    <div class="mock-step flex items-center gap-1.5 pl-1" style="--step: 4">
      <span class="grid h-6 w-6 place-items-center rounded-md border border-line text-fg-subtle" aria-hidden="true">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12" /><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z" /></svg>
      </span>
      <span class="grid h-6 w-6 place-items-center rounded-md border border-line text-fg-subtle" aria-hidden="true">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V2" /><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22h0a3.13 3.13 0 0 1-3-3.88Z" /></svg>
      </span>
    </div>

    <div class="flex items-center gap-2 pt-1">
      <span class="flex min-w-0 flex-1 items-center rounded-full border border-line bg-surface px-3 py-1.5 text-[10.5px] text-fg-subtle">Enter a question</span>
      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-action text-on-action" aria-hidden="true">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z" /><path d="M22 2 11 13" /></svg>
      </span>
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
// Closed beta: the account question stays open until a person answers it —
// no auto-resolution, so the prompt below is warn, not action. The copy
// grants asking a specific question, never proposing or ranking candidate
// accounts, so the box states the question and stops there — no shortlist.
// This is a field/value panel for one document, not a list of records like
// the sibling Journal/Close screens, and the unresolved item (the account)
// isn't one of the extracted fields shown here — so there is no row to mark
// selected; the warn callout is what carries the open item instead.
const fields = [
  { label: 'Supplier', value: 'Supplier A' },
  { label: 'Date', value: '12 Mar' },
  { label: 'Amount', value: '$84.00' },
  { label: 'Currency', value: 'SGD' },
  { label: 'Terms', value: 'Net 30' },
];
---
<MockFrame title="Bookkeeping — Review" meta="1 question">
  <div class="space-y-2.5">
    <div class="flex gap-2.5">
      <div class="grid h-12 w-9 shrink-0 place-items-center rounded-[4px] border border-line bg-surface-2 text-fg-subtle/60">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
        </svg>
      </div>
      <div class="flex-1 space-y-1.5">
        {fields.map((f) => (
          <div class="flex items-center gap-1.5">
            <span class="w-16 shrink-0 font-head text-[9.5px] uppercase tracking-[0.08em] text-fg-subtle">{f.label}</span>
            <span class="flex-1 truncate text-[12px] tabular-nums text-fg">{f.value}</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <path d="m20 6-11 11-5-5" />
            </svg>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-1.5 rounded-lg border border-line bg-warn-soft p-2.5">
      <div class="flex items-center gap-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-warn" aria-hidden="true">
          <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
        </svg>
        <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-warn">Open question</span>
      </div>
      <p class="text-[12px] text-fg">Which account does this belong to?</p>
    </div>
  </div>
</MockFrame>

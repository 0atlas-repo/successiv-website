---
import MockFrame from './MockFrame.astro';
---
<MockFrame title="Contracts — Clause lookup" meta="Sourced">
  <div class="space-y-3">
    <div class="space-y-1.5">
      <p class="text-[12px] leading-snug text-fg-muted">Does the <span class="tabular-nums">Nov 2025</span> variation need approval before certification?</p>
      <p class="rounded-lg border border-line bg-surface px-3 py-2 text-[12px] leading-snug text-fg">
        Yes — a variation needs approval before a certificate can reference it.
      </p>
      <div class="flex items-start gap-2 rounded-lg border border-line px-2.5 py-2">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-fg-subtle" aria-hidden="true">
          <path d="M6 3h12v18l-6-4-6 4Z" />
        </svg>
        <div class="min-w-0 flex-1">
          <div class="font-head text-[9.5px] uppercase tabular-nums tracking-[0.08em] text-fg-subtle">Clause 11.4 — Variations</div>
          <div class="tabular-nums text-[10.5px] text-fg-subtle">Contract 04, page 18</div>
        </div>
        <span class="mt-0.5 shrink-0 text-action" aria-hidden="true">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 10v12" /><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z" />
          </svg>
        </span>
      </div>
    </div>

    <div class="space-y-1.5 border-t border-line pt-2.5">
      <p class="text-[12px] leading-snug text-fg-muted">Can the completion date be extended for a force majeure event?</p>
      <p class="rounded-lg border border-line bg-surface px-3 py-2 text-[12px] leading-snug text-fg">
        Yes — a force majeure event qualifies as a relief event, subject to notice within <span class="tabular-nums">7</span> days.
      </p>
      <div class="flex items-start gap-2 rounded-lg border border-line px-2.5 py-2">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-fg-subtle" aria-hidden="true">
          <path d="M6 3h12v18l-6-4-6 4Z" />
        </svg>
        <div class="min-w-0">
          <div class="font-head text-[9.5px] uppercase tabular-nums tracking-[0.08em] text-fg-subtle">Clause 14.2 — Relief events</div>
          <div class="tabular-nums text-[10.5px] text-fg-subtle">Contract 04, page 22</div>
        </div>
      </div>
      <div class="flex items-center gap-2 pt-0.5">
        <span class="text-[10.5px] text-fg-subtle">Rate this answer</span>
        <span class="ml-auto flex shrink-0 items-center gap-1.5">
          <span class="grid h-6 w-6 place-items-center rounded-md border border-line text-fg-subtle" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 10v12" /><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z" />
            </svg>
          </span>
          <span class="grid h-6 w-6 place-items-center rounded-md border border-line text-fg-subtle" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 14V2" /><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22h0a3.13 3.13 0 0 1-3-3.88Z" />
            </svg>
          </span>
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2 pt-0.5">
      <span class="flex min-w-0 flex-1 items-center rounded-full border border-line bg-surface px-3 py-1.5 text-[10.5px] text-fg-subtle">
        Ask about this contract
      </span>
      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-action text-on-action">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m22 2-7 20-4-9-9-4z" /><path d="M22 2 11 13" />
        </svg>
      </span>
    </div>
  </div>
</MockFrame>

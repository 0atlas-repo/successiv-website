---
import MockFrame from './MockFrame.astro';
const items = [
  { headline: 'Quarterly update', date: 'Mar 12', status: 'Published', attachments: 0 },
  { headline: 'New office opens', date: 'Mar 08', status: 'Published', attachments: 2 },
  { headline: 'Holiday schedule', date: 'Mar 02', status: 'Draft', attachments: 0 },
  { headline: 'Team welcomes new hires', date: 'Feb 24', status: 'Published', attachments: 0 },
];
---
<MockFrame title="CMS — News" meta="4 items">
  <div class="space-y-1.5">
    {items.map((i) => (
      <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/40 px-2.5 py-2">
        <div class="min-w-0 flex-1">
          <div class="truncate text-[10.5px] text-fg">{i.headline}</div>
          <div class="mt-0.5 text-[10px] text-fg-subtle">{i.date}</div>
        </div>
        {i.attachments > 0 && (
          <span class="flex shrink-0 items-center gap-1 text-fg-subtle">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.44 11.05l-6.19 6.19a4 4 0 01-5.66-5.66l6.19-6.19a2.5 2.5 0 013.54 3.54l-6.2 6.19a1 1 0 01-1.41-1.41" />
            </svg>
            <span class="text-[9px]">{i.attachments}</span>
          </span>
        )}
        <span
          class:list={[
            'shrink-0 rounded-full px-2 py-0.5 font-head text-[9px] uppercase tracking-[0.08em]',
            i.status === 'Published' ? 'bg-action/10 text-action' : 'border border-line text-fg-subtle',
          ]}
        >
          {i.status}
        </span>
      </div>
    ))}
  </div>
</MockFrame>

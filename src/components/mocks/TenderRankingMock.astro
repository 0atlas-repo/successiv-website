---
import MockFrame from './MockFrame.astro';
const rows = [
  { rank: 1, v: 'Vendor B', total: '86.4' },
  { rank: 2, v: 'Vendor A', total: '81.2' },
  { rank: 3, v: 'Vendor C', total: '74.0' },
  { rank: 4, v: 'Vendor D', total: '68.5' },
  { rank: 5, v: 'Vendor E', total: '61.9' },
];
---
<MockFrame chrome="sidebar" title="Tender — Ranking" meta="Final">
  <div class="space-y-2">
    <div class="grid grid-cols-[16px_1fr_40px] items-center gap-2 border-b border-line pb-1.5">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">#</span>
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Bidder</span>
      <span class="text-right font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Total</span>
    </div>
    {rows.map((r) => (
      <div
        class:list={[
          'grid grid-cols-[16px_1fr_40px] items-center gap-2 rounded-lg border px-1.5 py-1',
          r.rank === 1 ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <span class:list={['font-head text-[10.5px] tabular-nums', r.rank === 1 ? 'font-semibold text-action' : 'text-fg-subtle']}>{r.rank}</span>
        <span class:list={['truncate text-[12px]', r.rank === 1 ? 'font-medium text-fg' : 'text-fg-muted']}>{r.v}</span>
        <span class:list={['text-right font-head text-[12px] font-semibold tabular-nums', r.rank === 1 ? 'text-action' : 'text-fg-muted']}>{r.total}</span>
      </div>
    ))}
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Weighted total · locked on award</span>
    </div>
  </div>
</MockFrame>

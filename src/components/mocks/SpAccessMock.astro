---
import MockFrame from './MockFrame.astro';
---
<MockFrame title="Governance — Temporary access" meta="Expires 14d">
  <div class="space-y-2.5">
    <div class="space-y-1">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Recipient</span>
      <div class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-[12px] text-fg">A. Chan</div>
    </div>
    <div class="space-y-1">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Access bundle</span>
      <div class="flex items-center justify-between rounded-md border border-line bg-surface px-2.5 py-1.5">
        <span class="text-[12px] text-fg">Viewer bundle</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </div>
    </div>
    <div class="space-y-1">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Expires</span>
      <div class="flex items-center gap-2 rounded-md border border-line bg-surface px-2.5 py-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
          <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" />
        </svg>
        <span class="text-[12px] text-fg">14 days from today</span>
      </div>
    </div>
    <div class="flex items-start gap-2 rounded-lg border border-dashed border-line px-2.5 py-2">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 shrink-0 text-fg-subtle" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" />
      </svg>
      <p class="text-[10.5px] leading-snug text-fg-subtle">Access is removed automatically on expiry — no manual follow-up needed.</p>
    </div>
    <div class="flex gap-2 border-t border-line pt-2.5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action">Grant access</span>
      <span class="flex-1 rounded-full border border-line py-1.5 text-center font-head text-[10.5px] font-semibold text-fg-muted">Cancel</span>
    </div>
  </div>
</MockFrame>

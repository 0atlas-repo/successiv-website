---
import MockFrame from './MockFrame.astro';
// The "Why" box shows partial, real text rather than skeleton bars — a
// nominator has started writing but not finished, which is why "Incomplete"
// reads as warn rather than danger: a normal mid-fill state, not a failure.
// No row here is marked "selected" — this is a single form, not a list of
// interchangeable records, so the current-row treatment doesn't apply.
const categories = ['Initiative', 'Craftsmanship', 'Reliability', 'Mentorship'];
const selected = 1;
---
<MockFrame title="Awards — Nomination" meta="Open">
  <div class="space-y-2.5">
    <div class="space-y-1">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Category</span>
      <div class="flex flex-wrap gap-1.5">
        {categories.map((c, i) => (
          <span
            class:list={[
              'rounded-full px-2.5 py-1 font-head text-[9.5px] font-semibold',
              i === selected ? 'bg-action text-on-action' : 'border border-line text-fg-muted',
            ]}
          >
            {c}
          </span>
        ))}
      </div>
    </div>
    <div class="space-y-1">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Nominee</span>
      <div class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-[12px] text-fg">Team B</div>
    </div>
    <div class="space-y-1">
      <div class="flex items-center gap-1.5">
        <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Why</span>
        <span class="shrink-0 whitespace-nowrap rounded-full bg-warn-soft px-1.5 py-px font-head text-[9px] font-semibold uppercase tracking-[0.06em] text-warn">Incomplete</span>
      </div>
      <div class="rounded-lg border border-line bg-surface p-2.5">
        <p class="text-[12px] leading-snug text-fg">Redesigned the onboarding flow twice after user testing found problems, and the version that shipped held up under real signups.</p>
      </div>
    </div>
    <div class="flex gap-2 border-t border-line pt-2.5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action">Submit nomination</span>
    </div>
    <div class="flex items-center gap-2">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Nominations close in <span class="tabular-nums">6</span> days</span>
    </div>
  </div>
</MockFrame>

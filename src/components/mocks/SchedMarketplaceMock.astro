---
import MockFrame from './MockFrame.astro';
const providers = [
  { name: 'Provider A', service: 'Haircut & style', duration: '45 min', price: '$60' },
  { name: 'Provider B', service: 'Deep tissue massage', duration: '60 min', price: '$95' },
  { name: 'Provider C', service: 'Manicure', duration: '30 min', price: '$40' },
];
---
<MockFrame title="Booking — Services" meta="3 providers">
  <div class="space-y-2">
    {providers.map((p) => (
      <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/40 p-2.5">
        <div class="h-8 w-8 shrink-0 rounded-full bg-fg-subtle/20"></div>
        <div class="min-w-0 flex-1">
          <div class="truncate font-head text-[11px] font-medium text-fg">{p.name}</div>
          <div class="mt-0.5 flex items-baseline gap-1.5">
            <span class="truncate text-[10px] text-fg-subtle">{p.service}</span>
            <span class="shrink-0 text-[9px] text-fg-subtle">· {p.duration}</span>
          </div>
        </div>
        <span class="shrink-0 font-head text-[12px] font-bold text-fg">{p.price}</span>
      </div>
    ))}
  </div>
</MockFrame>

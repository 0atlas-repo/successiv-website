---
import MockFrame from './MockFrame.astro';
// A fuller day than a 45-minute cadence usually shows on a wireframe: slots
// keep the copy's fixed rhythm (each service reserves its own cooldown
// automatically, so the grid — not a manual check — is what keeps two
// bookings from sitting back-to-back). Free reads as the inviting state here
// (bg-ok-soft) since this is the customer picking a time; taken is a plain,
// de-emphasised surface rather than a grey warning fill.
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
const activeDay = 3;
const slots = [
  { time: '9:00', state: 'available' },
  { time: '9:45', state: 'unavailable' },
  { time: '10:30', state: 'selected' },
  { time: '11:15', state: 'available' },
  { time: '12:00', state: 'unavailable' },
  { time: '12:45', state: 'available' },
  { time: '13:30', state: 'available' },
  { time: '14:15', state: 'unavailable' },
  { time: '15:00', state: 'available' },
  { time: '15:45', state: 'available' },
  { time: '16:30', state: 'unavailable' },
  { time: '17:15', state: 'available' },
];
---
<MockFrame chrome="panel" title="Booking — Availability" meta="Thu">
  <div class="space-y-2.5">
    <div class="flex gap-1.5">
      {days.map((d, i) => (
        <span
          class:list={[
            'flex-1 rounded-full py-1 text-center font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
            i === activeDay ? 'bg-action text-on-action' : 'border border-line text-fg-muted',
          ]}
        >
          {d}
        </span>
      ))}
    </div>

    <div class="grid grid-cols-3 gap-1.5">
      {slots.map((s) => (
        <span
          class:list={[
            'rounded-md border py-1.5 text-center text-[10.5px] tabular-nums',
            s.state === 'selected'
              ? 'border-transparent bg-action font-semibold text-on-action'
              : s.state === 'unavailable'
                ? 'border-line bg-surface text-fg-subtle'
                : 'border-transparent bg-ok-soft font-medium text-ok',
          ]}
        >
          {s.time}
        </span>
      ))}
    </div>

    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Gap after each service is reserved automatically</span>
    </div>
  </div>
</MockFrame>

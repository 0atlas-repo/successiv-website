---
import MockFrame from './MockFrame.astro';
const tickets = [
  { subject: 'Refund on damaged item', type: 'Refund', status: 'Open' },
  { subject: 'Wrong size sent', type: 'Return', status: 'Open' },
  { subject: 'Delivery delay question', type: 'General', status: 'Closed' },
];
---
<MockFrame title="Assistant — Tickets" meta="2 open">
  <div class="space-y-2">
    <div class="space-y-1.5">
      {tickets.map((t) => (
        <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/40 px-2.5 py-2">
          <span class="min-w-0 flex-1 truncate text-[10.5px] text-fg">{t.subject}</span>
          <span class="shrink-0 rounded-full border border-line px-1.5 py-0.5 font-head text-[9px] uppercase tracking-[0.08em] text-fg-subtle">
            {t.type}
          </span>
          <span
            class:list={[
              'shrink-0 rounded-full px-2 py-0.5 font-head text-[9px] uppercase tracking-[0.08em]',
              t.status === 'Open' ? 'border border-line text-fg-muted' : 'text-fg-subtle',
            ]}
          >
            {t.status}
          </span>
        </div>
      ))}
    </div>
    <div class="flex items-start gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
      </svg>
      <p class="text-[10px] leading-snug text-fg-subtle">Raised by the assistant when it escalated — not a guess.</p>
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
// Types are exactly the four the assistant raises tickets as: refund, return,
// cancellation, general. No status pill: the product doesn't mark a ticket
// resolved — that's back-office work the copy explicitly excludes.
// Refs are "T-nnnn", not "#nnnn" — a digit-only string after "#" reads as a
// hex colour to a naive checker (ChatMock's "Ticket 4821" avoids the same trap).
const tickets = [
  { ref: 'T-1042', subject: 'Refund on damaged item', type: 'Refund', selected: true },
  { ref: 'T-1041', subject: 'Wrong size sent', type: 'Return' },
  { ref: 'T-1039', subject: 'Cancel before dispatch', type: 'Cancellation' },
  { ref: 'T-1037', subject: 'Order not arrived yet', type: 'General' },
  { ref: 'T-1033', subject: 'Exchange for a larger size', type: 'Return' },
  { ref: 'T-1028', subject: 'Delivery delay question', type: 'General' },
];
---
<MockFrame chrome="sidebar" title="Assistant — Tickets" meta="6 tickets">
  <div class="space-y-2">
    <div class="space-y-1.5">
      {tickets.map((t) => (
        <div
          class:list={[
            'flex items-center gap-2.5 rounded-lg border px-2.5 py-2',
            t.selected ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
          ]}
        >
          <span class="shrink-0 whitespace-nowrap font-head text-[9.5px] tabular-nums text-fg-subtle">{t.ref}</span>
          <span class="min-w-0 flex-1 truncate text-[12px] text-fg">{t.subject}</span>
          <span class="shrink-0 whitespace-nowrap rounded-full border border-line px-1.5 py-0.5 font-head text-[9.5px] uppercase tracking-[0.08em] text-fg-subtle">
            {t.type}
          </span>
        </div>
      ))}
    </div>
    <div class="flex items-start gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
      </svg>
      <p class="text-[10.5px] leading-snug text-fg-subtle">Raised by the assistant when it escalated — not a guess.</p>
    </div>
  </div>
</MockFrame>

---
// Dispatcher: maps a product's screen name to its component, so pages stay
// data-driven and no page hardcodes which screen belongs to which product.
//
// Record<ProductMock, ...> means adding a name to the union without building
// the screen is a build error, not a blank space someone notices in review.
import CreatorExploreMock from './CreatorExploreMock.astro';
import CreatorApplyMock from './CreatorApplyMock.astro';
import CreatorSubmitMock from './CreatorSubmitMock.astro';
import CreatorCheckMock from './CreatorCheckMock.astro';
import CreatorTrackMock from './CreatorTrackMock.astro';
import ShopConnectMock from './ShopConnectMock.astro';
import ShopAnswerMock from './ShopAnswerMock.astro';
import ShopEscalateMock from './ShopEscalateMock.astro';
import ShopTicketMock from './ShopTicketMock.astro';
import ShopKnowledgeAddMock from './ShopKnowledgeAddMock.astro';
import KycHomeMock from './KycHomeMock.astro';
import KycAddMock from './KycAddMock.astro';
import KycRequestMock from './KycRequestMock.astro';
import KycConsentMock from './KycConsentMock.astro';
import KycPortalMock from './KycPortalMock.astro';
import CalendarMock from './CalendarMock.astro';
import AcctUploadMock from './AcctUploadMock.astro';
import AcctReadingMock from './AcctReadingMock.astro';
import AcctDraftMock from './AcctDraftMock.astro';
import AcctQuestionMock from './AcctQuestionMock.astro';
import AcctBankMock from './AcctBankMock.astro';
import GenericMock from './GenericMock.astro';
import type { ProductMock } from '../../content/products';

interface Props { mock: ProductMock }
const { mock } = Astro.props;

const screens: Record<ProductMock, any> = {
  'cs-explore': CreatorExploreMock,
  'cs-apply': CreatorApplyMock,
  'cs-submit': CreatorSubmitMock,
  'cs-check': CreatorCheckMock,
  'cs-track': CreatorTrackMock,
  'shop-connect': ShopConnectMock,
  'shop-answer': ShopAnswerMock,
  'shop-escalate': ShopEscalateMock,
  'shop-ticket': ShopTicketMock,
  'shop-knowledge-add': ShopKnowledgeAddMock,
  'kyc-home': KycHomeMock,
  'kyc-add': KycAddMock,
  'kyc-request': KycRequestMock,
  'kyc-consent': KycConsentMock,
  'kyc-portal': KycPortalMock,
  'calendar': CalendarMock,
  'acct-upload': AcctUploadMock,
  'acct-reading': AcctReadingMock,
  'acct-draft': AcctDraftMock,
  'acct-question': AcctQuestionMock,
  'acct-bank': AcctBankMock,
  'generic': GenericMock,
};

const Screen = screens[mock];
---
{Screen && <Screen />}

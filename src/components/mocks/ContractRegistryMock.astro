---
import MockFrame from './MockFrame.astro';
// Every contract carries one manually-set status ("Live") — the copy only
// backs deliberate, manual status changes, not a renewal/expiry schedule, so
// there is no second status value to show. The current row is picked by
// submission count, not by any notion of a deadline.
const contracts = [
  { ref: 'CN-04', title: 'Service agreement', open: 2 },
  { ref: 'CN-11', title: 'Supply agreement', open: 0 },
  { ref: 'CN-15', title: 'Framework agreement', open: 1 },
  { ref: 'CN-18', title: 'Advisory retainer', open: 3, selected: true },
  { ref: 'CN-22', title: 'Maintenance agreement', open: 1 },
  { ref: 'CN-27', title: 'Consultancy agreement', open: 0 },
];
---
<MockFrame title="Contracts — Register" meta="6 active">
  <div class="space-y-1.5">
    {contracts.map((c) => (
      <div
        class:list={[
          'flex items-center gap-2.5 rounded-lg border px-2.5 py-2',
          c.selected ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <div class="grid h-7 w-7 shrink-0 place-items-center rounded-md border border-line bg-surface-2 text-fg-subtle/60">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" /><path d="M14 2v6h6" />
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-baseline gap-1.5">
            <span class="shrink-0 font-head text-[9.5px] tabular-nums tracking-[0.06em] text-fg-subtle">{c.ref}</span>
            <span class="truncate text-[12px] text-fg">{c.title}</span>
          </div>
          <div class="mt-0.5 text-[10.5px] text-fg-subtle"><span class="tabular-nums">{c.open}</span> submission{c.open === 1 ? '' : 's'}</div>
        </div>
        <span class="shrink-0 whitespace-nowrap rounded-full bg-ok-soft px-2 py-0.5 font-head text-[9.5px] uppercase tracking-[0.08em] text-ok">
          Live
        </span>
      </div>
    ))}
  </div>
</MockFrame>

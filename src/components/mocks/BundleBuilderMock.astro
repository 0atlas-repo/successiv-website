---
import MockFrame from './MockFrame.astro';
const sources = [
  { seq: 1, name: 'Cover letter', fmt: 'DOCX' },
  { seq: 2, name: 'Reference report', fmt: 'PDF' },
  { seq: 3, name: 'Site photo', fmt: 'JPG' },
  { seq: 4, name: 'Handwritten notes', fmt: 'TXT' },
];
---
<MockFrame title="Bundle — Assembly" meta="4 sources">
  <div class="space-y-2">
    {sources.map((s) => (
      <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/40 px-2.5 py-2">
        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line font-head text-[9px] font-semibold text-fg-subtle">
          {s.seq}
        </span>
        <span class="min-w-0 flex-1 truncate text-[10.5px] text-fg">{s.name}</span>
        <span class="shrink-0 rounded-[4px] border border-line px-1.5 py-0.5 font-head text-[9px] font-semibold uppercase tracking-[0.06em] text-fg-subtle">
          {s.fmt}
        </span>
      </div>
    ))}
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
      </svg>
      <span class="text-[10px] text-fg-subtle">Merged into one output file · PDF</span>
    </div>
  </div>
</MockFrame>

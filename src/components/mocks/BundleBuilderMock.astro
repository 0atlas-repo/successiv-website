---
import MockFrame from './MockFrame.astro';
// Conversion status is grounded in the entry's own copy: "converts each to
// PDF, and merges them in a caller-defined order" — so a source is either
// already converted, mid-conversion, or waiting its turn. No status here
// implies anything beyond that pipeline (no signing, no approval step).
type Status = 'done' | 'active' | 'queued';
type Source = { seq: number; name: string; fmt: string; status: Status };
const sources: Source[] = [
  { seq: 1, name: 'Cover letter', fmt: 'DOCX', status: 'done' },
  { seq: 2, name: 'Reference report', fmt: 'PDF', status: 'done' },
  { seq: 3, name: 'Site photo', fmt: 'JPG', status: 'active' },
  { seq: 4, name: 'Floor plan', fmt: 'PNG', status: 'queued' },
  { seq: 5, name: 'Handwritten notes', fmt: 'TXT', status: 'queued' },
  { seq: 6, name: 'Annex form', fmt: 'DOCX', status: 'queued' },
];
const statusMeta: Record<Status, { label: string; pill: string }> = {
  done: { label: 'Converted', pill: 'bg-ok-soft text-ok' },
  active: { label: 'Converting', pill: 'bg-warn-soft text-warn' },
  queued: { label: 'Queued', pill: 'bg-warn-soft text-warn' },
};
const isImage = (fmt: string) => fmt === 'JPG' || fmt === 'PNG';
---
<MockFrame title="Bundle — Assembly" meta={`${sources.length} sources`}>
  <div class="space-y-2">
    {sources.map((s) => (
      <div
        class:list={[
          'flex items-center gap-2.5 rounded-lg border px-2.5 py-2',
          s.status === 'active' ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <div class="grid h-7 w-7 shrink-0 place-items-center rounded-md border border-line bg-surface-2 text-fg-subtle/60">
          {isImage(s.fmt) ? (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2.5" /><circle cx="9" cy="9" r="1.75" /><path d="m21 15-4.35-4.35a2 2 0 0 0-2.83 0L4 21" />
            </svg>
          ) : (
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
            </svg>
          )}
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-baseline gap-1.5">
            <span class="shrink-0 font-head text-[9.5px] tabular-nums tracking-[0.06em] text-fg-subtle">{s.seq}</span>
            <span class="truncate text-[12px] text-fg">{s.name}</span>
          </div>
          <span class="mt-0.5 inline-block rounded-[4px] border border-line px-1.5 py-0.5 font-head text-[9.5px] font-semibold uppercase tracking-[0.06em] text-fg-subtle">
            {s.fmt}
          </span>
        </div>
        <span
          class:list={[
            'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
            statusMeta[s.status].pill,
          ]}
        >
          {statusMeta[s.status].label}
        </span>
      </div>
    ))}
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Merged into one output file · PDF</span>
    </div>
  </div>
</MockFrame>

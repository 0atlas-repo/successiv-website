---
import MockFrame from './MockFrame.astro';
// No source-type badge and no archive/active status: the copy only says the
// knowledge base is "editable" — it never names file/URL ingestion or an
// archive lifecycle, so neither is shown here.
const entries = [
  { name: 'Returns policy', selected: true },
  { name: 'Shipping policy' },
  { name: 'Delivery FAQ' },
  { name: 'Store hours' },
  { name: 'Size guide' },
  { name: 'Warranty terms' },
];
---
<MockFrame chrome="sidebar" title="Assistant — Knowledge" meta="6 sources">
  <div class="space-y-1.5">
    {entries.map((e) => (
      <div
        class:list={[
          'flex items-center gap-2.5 rounded-lg border px-2.5 py-1.5',
          e.selected ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" />
        </svg>
        <span class="min-w-0 flex-1 truncate text-[12px] text-fg">{e.name}</span>
      </div>
    ))}
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
---
<MockFrame title="Incident — Assistant" meta="Sourced">
  <div class="space-y-2.5">
    <div class="flex justify-end">
      <p class="max-w-[78%] rounded-2xl rounded-br-sm bg-action px-3 py-2 text-[11px] leading-snug text-on-action">
        What's the next step for Site B?
      </p>
    </div>

    <div class="flex justify-start">
      <div class="max-w-[85%] space-y-1.5">
        <p class="rounded-2xl rounded-bl-sm border border-line bg-bg/50 px-3 py-2 text-[11px] leading-snug text-fg">
          Notify the duty lead and log the time before proceeding.
        </p>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-full border border-line px-2 py-0.5 font-head text-[9px] text-fg-subtle">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z" />
            </svg>
            Procedure 3.4
          </span>
          <span class="ml-auto flex items-center gap-1.5 text-fg-subtle">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 22V11l5-9a2 2 0 0 1 2 2v6h6a2 2 0 0 1 2 2.2l-1.4 7A2 2 0 0 1 18.6 22H7Z" /><path d="M3 11h4v11H3z" />
            </svg>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 2v11l-5 9a2 2 0 0 1-2-2v-6H4a2 2 0 0 1-2-2.2l1.4-7A2 2 0 0 1 5.4 2H17Z" /><path d="M21 13h-4V2h4z" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
const docs = [
  { type: 'Passport', condition: 'Verified' },
  { type: 'Proof of address', condition: 'Issued within 12m' },
];
---
<MockFrame title="Identity — Share" meta="Expires 9:58">
  <div class="space-y-2.5">
    <div class="text-[10px] text-fg-subtle">Store A requests:</div>
    <div class="space-y-1.5">
      {docs.map((d) => (
        <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/40 px-2.5 py-1.5">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" />
          </svg>
          <span class="min-w-0 flex-1 truncate text-[10.5px] text-fg">{d.type}</span>
          <span class="shrink-0 rounded-full border border-line px-1.5 py-0.5 font-head text-[9px] uppercase tracking-[0.08em] text-fg-subtle">
            {d.condition}
          </span>
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10px] font-semibold text-on-action">Share</span>
      <span class="flex shrink-0 items-center gap-1 rounded-full border border-line px-2.5 py-1.5 font-head text-[10px] font-semibold text-fg-muted">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
        </svg>
        9:58
      </span>
    </div>
  </div>
</MockFrame>

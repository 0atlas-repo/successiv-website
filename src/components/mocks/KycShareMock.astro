---
import MockFrame from './MockFrame.astro';
// Each condition below is something the counterparty attached to the request
// — verified or not, issued within a period, not expiring before a date —
// not the document's own state. They stay neutral rather than colour-pilled,
// because a green "Verified" here would claim the document has been checked
// when it only means the requester wants it checked.
const docs = [
  { type: 'Passport', condition: 'Valid past Mar 2027', icon: 'file', selected: true },
  { type: 'ID card', condition: 'Any', icon: 'file' },
  { type: 'Proof of address', condition: 'Issued within 12m', icon: 'file' },
  { type: 'Phone', condition: 'Verified', icon: 'phone' },
  { type: 'Email', condition: 'Verified', icon: 'mail' },
];
---
<MockFrame title="Identity — Share" meta="Expires 9:58">
  <div class="space-y-2.5">
    <div class="text-[10.5px] text-fg-subtle">Store A requests:</div>
    <div class="space-y-1.5">
      {docs.map((d) => (
        <div
          class:list={[
            'flex items-center gap-2.5 rounded-lg border px-2.5 py-1.5',
            d.selected ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
          ]}
        >
          {d.icon === 'phone' ? (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384" />
            </svg>
          ) : d.icon === 'mail' ? (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          ) : (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6" />
            </svg>
          )}
          <span class="min-w-0 flex-1 truncate text-[12px] text-fg">{d.type}</span>
          <span class="shrink-0 whitespace-nowrap rounded-full border border-line px-1.5 py-0.5 font-head text-[9.5px] uppercase tracking-[0.08em] tabular-nums text-fg-subtle">
            {d.condition}
          </span>
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action">Share</span>
      <span class="flex shrink-0 items-center gap-1 rounded-full border border-line px-2.5 py-1.5 font-head text-[10.5px] font-semibold tabular-nums text-fg-muted">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
        </svg>
        9:58
      </span>
    </div>
  </div>
</MockFrame>

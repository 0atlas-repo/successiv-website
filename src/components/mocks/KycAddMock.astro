---
import MockFrame from './MockFrame.astro';
// The phone app's passport entry screen. Its own app-bar title is never
// customised per document type — every document type opens under the literal
// title "Insert Document Page" (the phone app,
// `lib/pages/insert_document_page.dart:74`). Field labels "Name" and
// "Passport Number", and the tile labels "Upload Front Passport" /
// "Upload Back Passport", are its own (the phone app,
// `lib/pages/insert_document_page.dart:332,356,426,480`); the button is
// "Save" (`:602`). Field values are fake plausible fills, not the app's own
// placeholder hints.
// Source: local_pm/research/2026-09-24-kyc-ui-walkthrough.md, "Recommended
// screen per step" §2.
const fields = [
  { label: 'Name', value: 'A. Holder' },
  { label: 'Passport Number', value: 'A1234567' },
];
const uploadIcon = '<path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>';
const photoIcon = '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>';
const tiles = [
  { label: 'Upload Front Passport', swap: 3 },
  { label: 'Upload Back Passport', swap: 4 },
];
---
<MockFrame chrome="phone" title="Insert Document Page">
  <div class="space-y-2.5">
    {fields.map((f, i) => (
      <div class="mock-step space-y-1" style={`--step: ${i}`}>
        <p class="text-[10.5px] font-semibold text-fg">{f.label}</p>
        <p class="rounded-md border border-line bg-surface px-2 py-1.5 text-[11px] text-fg">{f.value}</p>
      </div>
    ))}
    <div class="mock-step grid grid-cols-2 gap-2" style="--step: 2">
      {tiles.map((t) => (
        <div class="grid">
          <div class="mock-before col-start-1 row-start-1 grid h-[64px] place-items-center gap-1 rounded-md border border-line px-1 text-fg-subtle/70" style={`--swap: ${t.swap}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={uploadIcon} /></svg>
            <span class="text-center text-[8.5px] leading-tight">{t.label}</span>
          </div>
          <div class="mock-step col-start-1 row-start-1 grid h-[64px] place-items-center rounded-md border border-line bg-surface-2 text-fg-subtle/70" style={`--step: ${t.swap}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={photoIcon} /></svg>
          </div>
        </div>
      ))}
    </div>
    <div class="mock-step rounded-full bg-action py-1.5 text-center font-head text-[11px] font-semibold text-on-action" style="--step: 5">
      Save
    </div>
  </div>
</MockFrame>

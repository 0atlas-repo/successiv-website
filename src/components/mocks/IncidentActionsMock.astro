---
import MockFrame from './MockFrame.astro';
const actions = [
  { label: 'Notify duty lead', done: true, time: '09:14', suggested: true },
  { label: 'Log incident summary', done: true, time: '09:16', suggested: false },
  { label: 'Notify facilities vendor', done: true, time: '09:20', suggested: false },
  { label: 'Confirm Site B status', done: false, suggested: true, current: true },
  { label: 'Verify access log entry', done: false, suggested: true },
  { label: 'Close out report', done: false, suggested: false },
];
const doneCount = actions.filter((a) => a.done).length;
---
<MockFrame title="Incident — Actions" meta={`${doneCount} of ${actions.length}`}>
  <div class="space-y-2">
    {actions.map((a) => (
      <div
        class:list={[
          'flex items-center gap-2.5 rounded-lg border px-2.5 py-2',
          a.current ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <span
          class:list={[
            'flex h-4 w-4 shrink-0 items-center justify-center rounded-[4px] border',
            a.done ? 'border-action bg-action' : 'border-line bg-bg',
          ]}
        >
          {a.done && (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-on-action" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          )}
        </span>
        <span class:list={['min-w-0 flex-1 truncate text-[12px]', a.done ? 'text-fg-muted' : 'text-fg']}>
          {a.label}
        </span>
        {a.suggested && (
          <span class="shrink-0 whitespace-nowrap rounded-full border border-line px-1.5 py-0.5 font-head text-[9.5px] uppercase tracking-[0.06em] text-fg-subtle">
            Suggested
          </span>
        )}
        {a.done ? (
          <span class="shrink-0 font-head text-[9.5px] tabular-nums text-fg-subtle">{a.time}</span>
        ) : (
          <span class="shrink-0 whitespace-nowrap rounded-full bg-warn-soft px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em] text-warn">
            Awaiting confirmation
          </span>
        )}
      </div>
    ))}
  </div>
</MockFrame>

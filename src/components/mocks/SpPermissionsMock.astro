---
import MockFrame from './MockFrame.astro';
const rows = [
  { principal: 'Team B', access: 'Edit', unique: false },
  { principal: 'A. Chan', access: 'Full control', unique: true },
  { principal: 'Finance group', access: 'Read', unique: false },
  { principal: 'Contractor group', access: 'Read', unique: false },
];
---
<MockFrame title="Governance — Permissions" meta="1 unique">
  <div class="space-y-2">
    <div class="grid grid-cols-[1fr_82px_16px] items-center gap-2 border-b border-line pb-1.5">
      <span class="font-head text-[9px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Principal</span>
      <span class="text-right font-head text-[9px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Access</span>
      <span></span>
    </div>
    {rows.map((r) => (
      <div class="grid grid-cols-[1fr_82px_16px] items-center gap-2">
        <span class="truncate text-[10.5px] text-fg">{r.principal}</span>
        <span class="text-right text-[10px] text-fg-muted">{r.access}</span>
        <span class="flex justify-end">
          {r.unique && (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-action" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
            </svg>
          )}
        </span>
      </div>
    ))}
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
      </svg>
      <span class="text-[10px] text-fg-subtle">Unique permissions break inheritance from the folder above</span>
    </div>
  </div>
</MockFrame>

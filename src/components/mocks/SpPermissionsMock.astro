---
import MockFrame from './MockFrame.astro';
// Access level doubles as the audit's own risk signal: Full control landing
// on an individual account (not a group) is the over-broad, inheritance-
// breaking grant this report exists to surface, so it drives both the pill
// colour and the one highlighted row. Principals are teams and groups, or a
// role when the grant is to one account — never a person's name.
type Access = 'Read' | 'Edit' | 'Full control';
type Row = { principal: string; access: Access; unique: boolean };
const rows: Row[] = [
  { principal: 'Team B', access: 'Edit', unique: false },
  { principal: 'Finance group', access: 'Read', unique: false },
  { principal: 'External contractor', access: 'Full control', unique: true },
  { principal: 'Contractor group', access: 'Read', unique: false },
  { principal: 'Support group', access: 'Edit', unique: false },
  { principal: 'Marketing group', access: 'Read', unique: false },
];
const accessPill: Record<Access, string> = {
  Read: 'bg-ok-soft text-ok',
  Edit: 'bg-warn-soft text-warn',
  'Full control': 'bg-danger-soft text-danger',
};
---
<MockFrame title="Governance — Permissions" meta="1 unique">
  <div class="space-y-2">
    <div class="flex items-center gap-2 border-b border-line pb-1.5">
      <span class="flex-1 font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Principal</span>
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Access</span>
    </div>
    <div class="space-y-1.5">
      {rows.map((r) => (
        <div
          class:list={[
            'flex items-center gap-2 rounded-lg border px-2.5 py-1.5',
            r.unique ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
          ]}
        >
          <span class="min-w-0 flex-1 truncate text-[12px] text-fg">{r.principal}</span>
          <span
            class:list={[
              'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
              accessPill[r.access],
            ]}
          >
            {r.access}
          </span>
          {r.unique && (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-action" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
            </svg>
          )}
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Unique permissions break inheritance from the folder above</span>
    </div>
  </div>
</MockFrame>

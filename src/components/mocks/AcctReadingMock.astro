---
import MockFrame from './MockFrame.astro';
// While the AI reads a bill, the only thing the shipped app shows is the task's
// progress strip: "Upload" done, then "Processing", then — when it stops for a
// person — "Pending", with the panel header "Review Request". There is no
// extracted-fields view: that card renders empty for every bill task, so it is
// not drawn. The strip's third node reads "Completed" until the task finishes.
// Source: local_pm/research/2026-09-24-accounting-ui-walkthrough.md, pass 2 §2.
---
<MockFrame chrome="panel" title="Task Details">
  <div class="space-y-3">
    <div class="flex items-start">
      <div class="mock-step flex w-1/3 flex-col items-center gap-1" style="--step: 0">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-ok-soft text-ok">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5" /></svg>
        </span>
        <span class="text-[10.5px] font-medium text-fg">Upload</span>
      </div>
      <div class="mock-step flex w-1/3 flex-col items-center gap-1" style="--step: 1">
        <span class="grid h-6 w-6 place-items-center rounded-full border-2 border-action bg-surface">
          <span class="block h-2 w-2 rounded-full bg-action"></span>
        </span>
        <span class="grid text-[10.5px] font-medium">
          <span class="mock-before col-start-1 row-start-1 text-center text-action" style="--swap: 3">Processing</span>
          <span class="mock-step col-start-1 row-start-1 text-center text-fg" style="--step: 3">Pending</span>
        </span>
      </div>
      <div class="mock-step flex w-1/3 flex-col items-center gap-1" style="--step: 2">
        <span class="h-6 w-6 rounded-full border-2 border-line bg-surface"></span>
        <span class="text-[10.5px] text-fg-subtle">Completed</span>
      </div>
    </div>
    <div class="mock-step rounded-lg border border-line bg-surface px-3 py-2.5" style="--step: 4">
      <p class="font-head text-[12px] font-semibold text-fg">Review Request</p>
      <p class="text-[10.5px] text-fg-subtle">Answer / approve agent request here</p>
    </div>
  </div>
</MockFrame>

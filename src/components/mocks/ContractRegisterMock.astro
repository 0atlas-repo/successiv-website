---
import MockFrame from './MockFrame.astro';
// The register: each card shows a contract's code and title, and who's
// handling it — the app's own card fields (the app,
// pages/Contracts/View.tsx:106-156). No status pill is drawn: an earlier
// version of this screen showed a "Live" pill, but the app's Contract model
// carries no status field, so nothing backs it. Creating a contract is a
// code, a title and an assigned member (the app,
// pages/Contracts/CreateContractDrawer.tsx:274-395) — classification and
// versioning start at the next step, once an entry is filed against it.
// Codes and titles are fictional examples in the app's own format;
// handlers are placeholder labels, not invented names — the research note
// flags the source repo's own demo data as carrying real staff names, so
// this mock avoids adding any invented-but-realistic ones of its own.
// The last card's highlighted border stands in for "just registered" — a
// directorial device, not a badge the app shows.
// Landscape (mock-colour pilot, 2026-09-28): laid out as the app lays it out,
// a card grid under a "New Contract" button with no page heading, each card
// carrying its Edit/Delete menu (the app, View.tsx:102, :140-147).
// Source: research note "contract-lifecycle", "1. Contracts" and
// "Recommended steps" step 1.
const contracts = [
  { code: 'CN-092', title: 'Framework agreement', handler: 'Handler A' },
  { code: 'CN-097', title: 'Advisory retainer', handler: 'Handler B' },
  { code: 'CN-101', title: 'Supply agreement', handler: 'Handler C' },
  { code: 'CN-104', title: 'Service agreement', handler: 'Handler D' },
];
const docIcon = '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" /><path d="M14 2v6h6" />';
const userIcon = '<path d="M20 21a8 8 0 1 0-16 0"/><circle cx="12" cy="7" r="4"/>';
const moreIcon = '<circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>';
const last = contracts[contracts.length - 1];
// The just-registered card is drawn twice, plain then highlighted: the
// crossfade can only replace a whole element, not recolour one in place.
const lastFrames = [
  { cls: 'mock-before border-line bg-surface', icon: 'bg-surface-2', style: '--swap: 4' },
  { cls: 'mock-step border-action/35 bg-surface-2', icon: 'bg-surface', style: '--step: 4' },
];
---
<MockFrame title="Contracts — Register" meta="4 contracts" desktop toolbar={false}>
  <div class="space-y-3">
    <div class="flex justify-end">
      <span class="flex items-center gap-1 rounded-md bg-action px-2.5 py-1.5 font-head text-[10.5px] font-semibold text-on-action">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        New Contract
      </span>
    </div>

    <div class="grid grid-cols-3 gap-2.5">
      {contracts.slice(0, -1).map((c, i) => (
        <div class="mock-step rounded-lg border border-line bg-surface p-2.5" style={`--step: ${i}`}>
          <div class="flex items-start justify-between">
            <div class="grid h-7 w-7 place-items-center rounded-md border border-line bg-surface-2 text-fg-subtle/60">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={docIcon} /></svg>
            </div>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-fg-subtle/70" aria-hidden="true"><Fragment set:html={moreIcon} /></svg>
          </div>
          <span class="mt-2.5 block font-head text-[9.5px] tabular-nums tracking-[0.06em] text-fg-subtle">{c.code}</span>
          <span class="block truncate text-[12px] text-fg">{c.title}</span>
          <div class="mt-2.5 flex items-center gap-1 border-t border-line pt-2 text-[10.5px] text-fg-subtle">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={userIcon} /></svg>
            {c.handler}
          </div>
        </div>
      ))}

      <div class="mock-step" style="--step: 3">
        <div class="grid">
          {lastFrames.map((f) => (
            <div class:list={['col-start-1 row-start-1 rounded-lg border p-2.5', f.cls]} style={f.style}>
              <div class="flex items-start justify-between">
                <div class:list={['grid h-7 w-7 place-items-center rounded-md border border-line text-fg-subtle/60', f.icon]}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={docIcon} /></svg>
                </div>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="text-fg-subtle/70" aria-hidden="true"><Fragment set:html={moreIcon} /></svg>
              </div>
              <span class="mt-2.5 block font-head text-[9.5px] tabular-nums tracking-[0.06em] text-fg-subtle">{last.code}</span>
              <span class="block truncate text-[12px] text-fg">{last.title}</span>
              <div class="mt-2.5 flex items-center gap-1 border-t border-line pt-2 text-[10.5px] text-fg-subtle">
                <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={userIcon} /></svg>
                {last.handler}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</MockFrame>

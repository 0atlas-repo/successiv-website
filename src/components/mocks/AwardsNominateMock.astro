---
import MockFrame from './MockFrame.astro';
// The landing page's own category tabs, read from a categories list — the
// portal, PrelaunchPanelWebPart.ts:150-166; the five values here are
// generic placeholders, not the real seeded set. The nomination form itself
// is a separate, external form product launched from this page, not
// rendered by this repo — the portal, PrelaunchPanelWebPart.ts:198-212.
// "Choose the Award", "I would like to nominate" and "Nominee" are that
// form's own field labels / field display name, kept verbatim (trailing
// colons not reproduced) — the nomination form's own field export. Its
// choice for that second question is genuinely two options, "a colleague" /
// "a team/project", kept verbatim, same source. "Reasons for nomination" is
// that form's own long-text field label, same source. Buttons there are
// Save / Submit / Exit; "Submit" is used here.
// The nomination window is a real admin-toggled phase, open while
// nominating — the portal, PrelaunchPanelWebPart.ts:382-393 — but no
// countdown or closing-date text exists anywhere in the real product, so
// none is shown here; the frame's "Open" label is the only window-state cue.
// Source: research note "awards-portals", Real flow §1-2 and Recommended
// steps §1.
const categories = ['Initiative', 'Craftsmanship', 'Reliability', 'Mentorship', 'Consistency'];
const selected = 1;
const types = ['a colleague', 'a team/project'];
const selectedType = 0;
---
<MockFrame chrome="panel" title="Awards — Nominate" meta="Open">
  <div class="space-y-2.5">
    <div class="mock-step space-y-1" style="--step: 0">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Choose the Award</span>
      <div class="flex flex-wrap gap-1.5">
        {categories.map((c, i) => (
          i === selected ? (
            <span class="grid">
              <span class="mock-before col-start-1 row-start-1 rounded-full border border-line px-2.5 py-1 font-head text-[9.5px] font-semibold text-fg-muted" style="--swap: 1">{c}</span>
              <span class="mock-step col-start-1 row-start-1 rounded-full bg-action px-2.5 py-1 font-head text-[9.5px] font-semibold text-on-action" style="--step: 1">{c}</span>
            </span>
          ) : (
            <span class="rounded-full border border-line px-2.5 py-1 font-head text-[9.5px] font-semibold text-fg-muted">{c}</span>
          )
        ))}
      </div>
    </div>

    <div class="mock-step space-y-1" style="--step: 2">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">I would like to nominate</span>
      <div class="flex gap-1.5">
        {types.map((t, i) => (
          <span class:list={['rounded-full px-2.5 py-1 font-head text-[9.5px] font-semibold', i === selectedType ? 'bg-action text-on-action' : 'border border-line text-fg-muted']}>{t}</span>
        ))}
      </div>
    </div>

    <div class="mock-step space-y-1" style="--step: 3">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Nominee</span>
      <div class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-[12px] text-fg">Candidate A</div>
    </div>

    <div class="mock-step space-y-1" style="--step: 4">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Reasons for nomination</span>
      <div class="rounded-lg border border-line bg-surface p-2.5">
        <p class="text-[12px] leading-snug text-fg">Consistently steps up when the team is under pressure, and other people notice.</p>
      </div>
    </div>

    <div class="mock-step flex gap-2 border-t border-line pt-2.5" style="--step: 5">
      <span class="flex-1 rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action">Submit</span>
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
// Preview writes the real page, just at a throwaway address rather than the
// eventual one — the admin app, StoriesDataAccess.cs:490-496 (scratch preview
// file) and :764 (a fixed-path preview page rendered per language, not the
// real slug). Save / Preview are the app's own two buttons, and Draft is its
// own status value — Stories.js:1057, 3283-3305. The address shown is an
// invented placeholder, not a real one.
// Source: local_pm/projects/mock-rollout/specs/copy-batch-b.md, "Content &
// CMS platforms" step 2.
---
<MockFrame chrome="sidebar" title="Publish" meta="Draft">
  <div class="space-y-2.5">
    <div class="mock-step flex items-center gap-2" style="--step: 0">
      <span class="shrink-0 whitespace-nowrap rounded-full bg-warn-soft px-2 py-1 font-head text-[9.5px] font-semibold uppercase tracking-[0.08em] text-warn">Draft</span>
      <span class="text-[10.5px] text-fg-subtle">Not on the public site yet</span>
    </div>

    <div class="mock-step rounded-full bg-action py-1.5 text-center font-head text-[10.5px] font-semibold text-on-action" style="--step: 1">
      Preview
    </div>

    <div class="mock-step space-y-1.5 rounded-lg border border-line bg-surface p-2.5" style="--step: 2">
      <div class="flex items-center gap-1.5 border-b border-line pb-1.5">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
        </svg>
        <span class="font-head text-[9.5px] text-fg-subtle">Preview — Quarterly update</span>
      </div>
      <p class="text-[10.5px] leading-snug text-fg-muted">
        A short recap of what shipped this quarter, written for the team rather than a press release.
      </p>
    </div>

    <p class="mock-step text-[10.5px] text-fg-subtle" style="--step: 3">Preview generated — view at a temporary address:</p>

    <div class="mock-step flex items-center gap-1.5 rounded-md border border-line bg-surface-2 px-2 py-1.5" style="--step: 4">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
      <span class="truncate font-mono text-[10px] text-fg">preview.example/preview</span>
    </div>
  </div>
</MockFrame>

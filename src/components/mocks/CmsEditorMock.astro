---
import MockFrame from './MockFrame.astro';
const languages = [
  { code: 'L1', active: true, complete: true },
  { code: 'L2', active: false, complete: true },
  { code: 'L3', active: false, complete: false },
];
---
<MockFrame chrome="sidebar" title="CMS — Story editor" meta="3 languages">
  <div class="space-y-2.5">
    <div class="flex gap-1.5">
      {languages.map((l) => (
        <span
          class:list={[
            'rounded-full px-2.5 py-1 font-head text-[9.5px] font-semibold uppercase tracking-[0.08em]',
            l.active ? 'bg-action text-on-action' : 'border border-line text-fg-subtle',
          ]}
        >
          {l.code}
        </span>
      ))}
    </div>

    <div class="space-y-1.5 rounded-lg border border-line bg-surface p-2.5">
      <div class="font-head text-[9.5px] uppercase tracking-[0.08em] text-fg-subtle">Title</div>
      <div class="text-[12px] font-medium text-fg">Quarterly update</div>
      <p class="pt-1 text-[10.5px] leading-snug text-fg-muted">
        A short recap of what shipped this quarter, written for the team rather than a press release.
      </p>
    </div>

    <div class="flex items-center gap-1.5 border-t border-line pt-2">
      {languages.map((l) => (
        <span
          class:list={[
            'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
            l.complete ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn',
          ]}
        >
          {l.code}
        </span>
      ))}
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
// The app's "Submit your live post" sheet: a thumbnail strip of the
// creator's own recent Instagram posts to pick from, and the "Submit proof"
// button. The manual "Live post URL" field is left out: the app shows it only
// in manual-entry mode or when no linked posts were found, never under a
// selected thumbnail. No spinner: the check itself is a queued background job (see
// CreatorCheckMock) — this screen only submits it.
// Source: local_pm/research/2026-09-24-creators-sphere-ui-walkthrough.md §4;
// the app, lib/features/campaign/presentation/widgets/proof_submission_sheet.dart:522
// ("Select Instagram Post"), :708 (URL field's real condition), :711 ("Live
// post URL"), :721 (URL hint text), :854 ("Submit proof").
const posts = [false, true, false];
const imgIcon = '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>';
---
<MockFrame chrome="phone" title="Submit your live post">
  <div class="space-y-2.5">
    <p class="mock-step font-head text-[9.5px] font-bold tracking-[0.08em] text-fg-subtle" style="--step: 0">Select Instagram Post</p>
    <div class="flex gap-2">
      {posts.map((selected, i) => (
        <div
          class:list={['mock-step grid h-14 w-14 shrink-0 place-items-center rounded-md text-fg-subtle/60', selected ? 'border-2 border-action bg-surface-2' : 'border border-line bg-surface-2']}
          style={`--step: ${i + 1}`}
        >
          {selected ? (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-action" aria-hidden="true"><path d="m20 6-11 11-5-5" /></svg>
          ) : (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={imgIcon} /></svg>
          )}
        </div>
      ))}
    </div>
    <div class="mock-step rounded-full bg-action py-1.5 text-center font-head text-[11px] font-semibold text-on-action" style="--step: 4">
      Submit proof
    </div>
  </div>
</MockFrame>

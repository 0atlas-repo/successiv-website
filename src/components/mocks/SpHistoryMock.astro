---
import MockFrame from './MockFrame.astro';
// A separate portal page, not a SharePoint list view — it opens in a new
// browser tab from a document's own right-click menu, prefilled to that item
// and a from-3-months-ago-to-today range — the audit portal,
// AuditCommandSet.ts:27-38. Its own heading is "Audit Log Search"; table
// columns Time / UserId / Operation; results caption "Total {n} Records,
// showing {a} - {b}"; button "Export To CSV" — Index.cshtml:82-169. Clicking
// a Time opens further detail — Details.cshtml:10-95 — but that view's own
// fields (Ip, Site, Web, ListId, ObjectId, UserAgent) are left off: they'd
// read as internal object and network identifiers, not as this feature.
// "FileCheckedOut" is a real ingested event type — the console app,
// AuditLogGetter.cs:24-30. The other two operation names are shown in the
// same real event-name shape but are not independently confirmed for this
// system. UserId is shown as a role, never a name or an actual identifier.
// Default "window" chrome on purpose: the real thing is its own application
// in a new tab, not a SharePoint page.
// Source: local_pm/projects/mock-rollout/specs/copy-batch-b.md, "SharePoint
// extensions".
const rows = [
  { time: '2026-09-10', user: 'External guest', op: 'FileModified' },
  { time: '2026-09-15', user: 'Records manager', op: 'FileCheckedOut' },
  { time: '2026-09-20', user: 'Finance analyst', op: 'FileAccessed' },
];
---
<MockFrame title="Audit Log Search" meta="3 records">
  <div class="space-y-2">
    <div class="mock-step flex flex-wrap items-center gap-1.5" style="--step: 0">
      <span class="rounded-md border border-line bg-surface px-2 py-1 text-[10.5px] text-fg">Quarterly plan.xlsx</span>
      <span class="rounded-md border border-line bg-surface px-2 py-1 text-[10.5px] text-fg-subtle">Last 3 months</span>
    </div>

    <p class="mock-step text-[9.5px] text-fg-subtle" style="--step: 1">Total 3 Records, showing 1 - 3</p>

    <div class="flex items-center gap-3 border-b border-line pb-1 text-[9.5px] uppercase tracking-[0.06em] text-fg-subtle">
      <span class="w-[58px] shrink-0">Time</span>
      <span class="flex-1">UserId</span>
      <span>Operation</span>
    </div>

    <div class="space-y-1">
      {rows.map((r, i) => (
        <div class="mock-step space-y-1" style={`--step: ${i + 2}`}>
          <div class="flex items-center gap-3 text-[10.5px]">
            <span class="w-[58px] shrink-0 tabular-nums text-action">{r.time}</span>
            <span class="min-w-0 flex-1 truncate text-fg-subtle">{r.user}</span>
            <span class="shrink-0 font-head text-[9.5px] text-fg-subtle">{r.op}</span>
          </div>
          {i === 1 && (
            <div class="mock-step ml-[70px] rounded-md border border-dashed border-line px-2 py-1 text-[9.5px] text-fg-subtle" style="--step: 5">
              Event: FileCheckedOut
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="mock-step border-t border-line pt-2.5" style="--step: 6">
      <span class="rounded-full border border-line px-2.5 py-1 font-head text-[9.5px] font-medium text-fg-muted">Export To CSV</span>
    </div>
  </div>
</MockFrame>

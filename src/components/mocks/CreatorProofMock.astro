---
import MockFrame from './MockFrame.astro';
type Check = { label: string; state: 'pass' | 'missing'; current?: boolean };
const checks: Check[] = [
  { label: 'Hashtag #BrandB', state: 'pass' },
  { label: 'Hashtag #BrandBLaunch', state: 'pass' },
  { label: 'Mention @brandb', state: 'pass' },
  { label: 'Mention @brandb.official', state: 'pass' },
  { label: 'Hashtag #campaignA', state: 'missing', current: true },
  { label: 'Mention @brandb.creators', state: 'missing' },
];
---
<MockFrame chrome="sidebar" title="Campaign — Proof" meta="Checking">
  <div class="space-y-2.5">
    <div class="flex items-center gap-2.5">
      <div class="grid h-12 w-12 shrink-0 place-items-center rounded-md border border-line bg-surface-2 text-fg-subtle/60">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" />
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <div class="font-head text-[12px] font-medium text-fg">Submitted post</div>
        <p class="mt-0.5 truncate text-[10.5px] text-fg-subtle">"Loved trying this — perfect for my morning routine."</p>
      </div>
    </div>

    <div class="space-y-1.5">
      {checks.map((c) => (
        <div
          class:list={[
            'flex items-center gap-2 rounded-lg border px-2.5 py-1.5',
            c.current ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
          ]}
        >
          {c.state === 'pass' ? (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-action" aria-hidden="true">
              <path d="m20 6-11 11-5-5" />
            </svg>
          ) : (
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" />
            </svg>
          )}
          <span class="flex-1 truncate text-[12px] text-fg">{c.label}</span>
          <span
            class:list={[
              'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
              c.state === 'pass' ? 'bg-ok-soft text-ok' : 'bg-danger-soft text-danger',
            ]}
          >
            {c.state === 'pass' ? 'Found' : 'Missing'}
          </span>
        </div>
      ))}
    </div>

    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Hashtags and mentions detected automatically</span>
    </div>
  </div>
</MockFrame>

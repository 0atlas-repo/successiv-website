---
import MockFrame from './MockFrame.astro';
---
<MockFrame title="Shopmgr — Store A" meta="Live">
  <div class="space-y-2.5">
    <div class="flex justify-end">
      <p class="max-w-[78%] rounded-2xl rounded-br-sm bg-action px-3 py-2 text-[11px] leading-snug text-on-action">
        Do you have the navy one in medium?
      </p>
    </div>

    <div class="flex justify-start">
      <div class="max-w-[85%] space-y-2">
        <p class="rounded-2xl rounded-bl-sm border border-line bg-bg/50 px-3 py-2 text-[11px] leading-snug text-fg">
          Yes — 4 left in medium, navy.
        </p>
        <div class="flex items-center gap-2.5 rounded-lg border border-line bg-bg/50 p-2">
          <div class="h-9 w-9 shrink-0 rounded-md bg-fg-subtle/20"></div>
          <div class="min-w-0 flex-1">
            <div class="truncate font-head text-[11px] font-medium text-fg">Everyday Jacket — Navy</div>
            <div class="text-[10px] text-fg-subtle">In stock · Ships today</div>
          </div>
          <span class="shrink-0 rounded-full bg-action px-2 py-1 font-head text-[9px] font-semibold text-on-action">Add</span>
        </div>
      </div>
    </div>

    <div class="flex justify-end">
      <p class="max-w-[78%] rounded-2xl rounded-br-sm bg-action px-3 py-2 text-[11px] leading-snug text-on-action">
        Can I return it after 60 days?
      </p>
    </div>

    <div class="flex items-start gap-2 rounded-lg border border-dashed border-line px-2.5 py-2">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
      </svg>
      <p class="text-[10px] leading-snug text-fg-subtle">
        Not covered by store policy — handed to a person rather than guessed.
      </p>
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
type Post = {
  creator: string;
  initials: string;
  likes: number;
  comments: number;
  updatedHours: number;
  current?: boolean;
};
const posts: Post[] = [
  { creator: '@creator1', initials: 'C1', likes: 128, comments: 14, updatedHours: 2, current: true },
  { creator: '@creator2', initials: 'C2', likes: 94, comments: 19, updatedHours: 5 },
  { creator: '@creator3', initials: 'C3', likes: 156, comments: 22, updatedHours: 6 },
  { creator: '@creator4', initials: 'C4', likes: 61, comments: 17, updatedHours: 9 },
  { creator: '@creator5', initials: 'C5', likes: 203, comments: 31, updatedHours: 12 },
  { creator: '@creator6', initials: 'C6', likes: 47, comments: 8, updatedHours: 18 },
];
---
<MockFrame title="Campaign — Delivery" meta={`${posts.length} posts`}>
  <div class="space-y-2">
    {posts.map((p) => (
      <div
        class:list={[
          'flex items-center gap-2.5 rounded-lg border p-2.5',
          p.current ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <div
          aria-hidden="true"
          class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-surface-2 text-[9.5px] font-semibold text-fg-subtle ring-1 ring-line"
        >
          {p.initials}
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex min-w-0 items-center gap-1.5">
            <span class="truncate font-head text-[12px] font-medium text-fg">{p.creator}</span>
            <span class="shrink-0 whitespace-nowrap rounded-full bg-ok-soft px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em] text-ok">Linked</span>
          </div>
          <div class="mt-0.5 text-[10.5px] text-fg-subtle">Updated <span class="tabular-nums">{p.updatedHours}</span>h ago</div>
        </div>
        <div class="flex shrink-0 items-center gap-2.5">
          <span class="flex items-center gap-1 text-[10.5px] text-fg-subtle">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.6z" />
            </svg>
            <span class="tabular-nums">{p.likes}</span>
          </span>
          <span class="flex items-center gap-1 text-[10.5px] text-fg-subtle">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.5 8.5 0 1 1-3.8-7.1L21 3l-1 4.9c.6 1.1 1 2.3 1 3.6z" />
            </svg>
            <span class="tabular-nums">{p.comments}</span>
          </span>
        </div>
      </div>
    ))}

    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /><path d="M3 21v-5h5" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Figures refresh on a schedule from the linked account</span>
    </div>
  </div>
</MockFrame>

---
import MockFrame from './MockFrame.astro';
// Six milestones so the trail runs past the frame edge. The open step reads
// "In review" because that is the literal state of the claim, not a computed
// deadline — there are no escalation timers or renewal dates behind this.
const events = [
  { label: 'Contract awarded', date: 'Jan', done: true },
  { label: 'Variation 01 approved', date: 'Apr', done: true },
  { label: 'Milestone: foundation complete', date: 'May', done: true },
  { label: 'Interim certificate 02 issued', date: 'Jul', done: true },
  { label: 'Variation 02 approved', date: 'Aug', done: true },
  { label: 'Claim 01 under review', date: 'Now', done: false },
];
---
<MockFrame title="Contract — CW-204" meta="Active">
  <div class="space-y-0">
    {events.map((e, i) => (
      <div class="grid grid-cols-[14px_1fr] gap-2.5">
        <div class="flex flex-col items-center">
          <span
            class:list={[
              'mt-0.5 block h-2.5 w-2.5 shrink-0 rounded-full border-2',
              e.done ? 'border-action bg-action' : 'border-action bg-bg',
            ]}
          ></span>
          {i < events.length - 1 && <span class="w-px flex-1 bg-line"></span>}
        </div>
        <div class:list={[i < events.length - 1 ? 'pb-2' : '']}>
          <div
            class:list={[
              'flex items-center gap-2 rounded-lg border px-2.5 py-1.5',
              e.done ? 'border-line bg-surface' : 'border-action/35 bg-surface-2',
            ]}
          >
            <span class:list={['min-w-0 flex-1 truncate tabular-nums text-[12px]', e.done ? 'text-fg-muted' : 'font-medium text-fg']}>{e.label}</span>
            <span
              class:list={[
                'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9px] uppercase tracking-[0.06em]',
                e.done ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn',
              ]}
            >
              {e.done ? 'Done' : 'In review'}
            </span>
            <span class="shrink-0 whitespace-nowrap font-head text-[9.5px] uppercase tabular-nums tracking-[0.08em] text-fg-subtle">{e.date}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</MockFrame>

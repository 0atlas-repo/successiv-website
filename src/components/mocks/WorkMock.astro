---
// Dispatcher: maps a work item's screen name to its component, so pages stay
// data-driven and no page hardcodes which screen belongs to which engagement.
//
// A lookup map rather than a chain of conditionals — at this count the chain
// stops being readable, and the Record<WorkMock, ...> type makes a missing key
// a build error instead of a silently blank panel.
import TenderListMock from './TenderListMock.astro';
import TenderCheckMock from './TenderCheckMock.astro';
import TenderQueryMock from './TenderQueryMock.astro';
import TenderSummaryMock from './TenderSummaryMock.astro';
import TenderScoresMock from './TenderScoresMock.astro';
import ContractRegisterMock from './ContractRegisterMock.astro';
import ContractFileMock from './ContractFileMock.astro';
import ContractCheckMock from './ContractCheckMock.astro';
import ContractAskMock from './ContractAskMock.astro';
import BundleAssembleMock from './BundleAssembleMock.astro';
import BundleFillMock from './BundleFillMock.astro';
import BundleMaskMock from './BundleMaskMock.astro';
import BundleLockMock from './BundleLockMock.astro';
import IncidentCaseMock from './IncidentCaseMock.astro';
import IncidentAskMock from './IncidentAskMock.astro';
import IncidentActionListMock from './IncidentActionListMock.astro';
import CmsDraftMock from './CmsDraftMock.astro';
import CmsPreviewMock from './CmsPreviewMock.astro';
import CmsReleaseMock from './CmsReleaseMock.astro';
import CmsQuickMock from './CmsQuickMock.astro';
import SpAuditMock from './SpAuditMock.astro';
import SpShareMock from './SpShareMock.astro';
import SpLinkCheckMock from './SpLinkCheckMock.astro';
import SpCheckedOutMock from './SpCheckedOutMock.astro';
import SpHistoryMock from './SpHistoryMock.astro';
import SchedServiceMock from './SchedServiceMock.astro';
import SchedBookMock from './SchedBookMock.astro';
import SchedConfirmMock from './SchedConfirmMock.astro';
import SchedSettleMock from './SchedSettleMock.astro';
import AwardsNominateMock from './AwardsNominateMock.astro';
import AwardsVoteMock from './AwardsVoteMock.astro';
import AwardsAnnounceMock from './AwardsAnnounceMock.astro';
import type { WorkMock } from '../../content/work';

interface Props { mock: WorkMock }
const { mock } = Astro.props;

const screens: Record<WorkMock, any> = {
  'awards-announce': AwardsAnnounceMock,
  'awards-vote': AwardsVoteMock,
  'awards-nominate': AwardsNominateMock,
  'sched-settle': SchedSettleMock,
  'sched-confirm': SchedConfirmMock,
  'sched-book': SchedBookMock,
  'sched-service': SchedServiceMock,
  'sp-history': SpHistoryMock,
  'sp-checked-out': SpCheckedOutMock,
  'sp-link-check': SpLinkCheckMock,
  'sp-share': SpShareMock,
  'sp-audit': SpAuditMock,
  'cms-quick': CmsQuickMock,
  'cms-release': CmsReleaseMock,
  'cms-preview': CmsPreviewMock,
  'cms-draft': CmsDraftMock,
  'incident-action-list': IncidentActionListMock,
  'incident-ask': IncidentAskMock,
  'incident-case': IncidentCaseMock,
  'bundle-lock': BundleLockMock,
  'bundle-mask': BundleMaskMock,
  'bundle-fill': BundleFillMock,
  'bundle-assemble': BundleAssembleMock,
  'contract-ask': ContractAskMock,
  'contract-check': ContractCheckMock,
  'contract-file': ContractFileMock,
  'contract-register': ContractRegisterMock,
  'tender-scores': TenderScoresMock,
  'tender-summary': TenderSummaryMock,
  'tender-query': TenderQueryMock,
  'tender-check': TenderCheckMock,
  'tender-list': TenderListMock,
};

const Screen = screens[mock];
---
{Screen && <Screen />}

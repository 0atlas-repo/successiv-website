---
import MockFrame from './MockFrame.astro';
// Six candidates so the shortlist runs past the frame edge like a real
// category page would — invented rows are the same kind already here (more
// teams), not a new candidate type the copy doesn't ask for.
// Team B is the one this voter already used their vote on: the "current"
// state a real shortlist always shows, and a cast vote reads as a settled,
// good state (ok), not a warning.
type Candidate = { name: string; initials: string; voted: boolean };
const candidates: Candidate[] = [
  { name: 'Team A', initials: 'TA', voted: false },
  { name: 'Team B', initials: 'TB', voted: true },
  { name: 'Team C', initials: 'TC', voted: false },
  { name: 'Team D', initials: 'TD', voted: false },
  { name: 'Team E', initials: 'TE', voted: false },
  { name: 'Team F', initials: 'TF', voted: false },
];
---
<MockFrame title="Awards — Shortlist" meta="Voting open">
  <div class="space-y-2.5">
    <div class="grid grid-cols-3 gap-2">
      {candidates.map((c) => (
        <div
          class:list={[
            'flex flex-col items-center gap-1.5 rounded-lg border px-2 py-2.5',
            c.voted ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
          ]}
        >
          <div class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line bg-bg font-head text-[10px] font-semibold text-fg-muted">
            {c.initials}
          </div>
          <span class="truncate text-[10.5px] text-fg">{c.name}</span>
          {c.voted ? (
            <span class="shrink-0 whitespace-nowrap rounded-full bg-ok-soft px-2 py-0.5 font-head text-[9px] font-semibold uppercase tracking-[0.06em] text-ok">
              Voted
            </span>
          ) : (
            <span class="shrink-0 whitespace-nowrap rounded-full bg-action px-2.5 py-0.5 font-head text-[9.5px] font-semibold text-on-action">Vote</span>
          )}
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Results stay hidden until voting closes</span>
    </div>
  </div>
</MockFrame>

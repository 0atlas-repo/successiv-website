---
import MockFrame from './MockFrame.astro';
const candidates = [
  { name: 'Team A', voted: false },
  { name: 'Team B', voted: true },
  { name: 'Team C', voted: false },
];
---
<MockFrame title="Awards — Shortlist" meta="Voting open">
  <div class="space-y-2.5">
    <div class="grid grid-cols-3 gap-2">
      {candidates.map((c) => (
        <div class="flex flex-col items-center gap-1.5 rounded-lg border border-line bg-bg/40 px-2 py-2.5">
          <div class="h-8 w-8 shrink-0 rounded-full bg-fg-subtle/20"></div>
          <span class="truncate text-[10px] text-fg">{c.name}</span>
          {c.voted ? (
            <span class="flex items-center gap-1.5 rounded-full border border-line px-2 py-0.5 font-head text-[9px] uppercase tracking-[0.06em] text-fg-subtle">
              <span class="block h-1.5 w-1.5 rounded-full bg-fg-subtle/50"></span>
              Voted
            </span>
          ) : (
            <span class="rounded-full bg-action px-2.5 py-0.5 font-head text-[9px] font-semibold text-on-action">Vote</span>
          )}
        </div>
      ))}
    </div>
    <div class="flex items-center gap-2 border-t border-line pt-2.5">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <span class="text-[10px] text-fg-subtle">Results stay hidden until voting closes</span>
    </div>
  </div>
</MockFrame>

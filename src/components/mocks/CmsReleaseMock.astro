---
import MockFrame from './MockFrame.astro';
// Before an overwrite the admin app copies the previous state to a timestamped
// backup file, then writes the new page for every language ticked available —
// the admin app, StoriesController.cs:76-82 (backup-before-overwrite) and
// :97-99, StoriesDataAccess.cs:756-766 (per-language static page write). No
// restore or rollback action exists anywhere in the admin app's code (its
// controllers, its data-access layer, or its UI) — an operator with server
// access would have to copy the backup file back over the live one by hand,
// so this mock has no Restore control. L3 is skipped in the checklist because
// it was never switched on for this piece, not because anything failed.
// Source: local_pm/projects/mock-rollout/specs/copy-batch-b.md, "Content &
// CMS platforms" step 3.
const results = [
  { code: 'L1', state: 'done' },
  { code: 'L2', state: 'done' },
  { code: 'L3', state: 'skipped' },
];
const checkIcon = '<path d="M20 6 9 17l-5-5"/>';
const dashIcon = '<path d="M5 12h14"/>';
---
<MockFrame chrome="sidebar" title="Publish">
  <div class="space-y-2.5">
    <div class="grid">
      <span class="mock-before col-start-1 row-start-1 flex w-fit shrink-0 items-center rounded-full bg-warn-soft px-2 py-1 font-head text-[9.5px] font-semibold uppercase tracking-[0.08em] text-warn" style="--swap: 0">Draft</span>
      <span class="mock-step col-start-1 row-start-1 flex w-fit shrink-0 items-center rounded-full bg-ok-soft px-2 py-1 font-head text-[9.5px] font-semibold uppercase tracking-[0.08em] text-ok" style="--step: 0">Published</span>
    </div>

    <div class="mock-step flex items-center gap-2 border-t border-line pt-2.5" style="--step: 1">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <rect x="4" y="3" width="16" height="18" rx="2" /><path d="M9 8h6M9 12h6" />
      </svg>
      <span class="text-[10.5px] text-fg-subtle">Backup saved at <span class="tabular-nums">14:02</span>, before publish</span>
    </div>

    <div class="space-y-1.5 border-t border-line pt-2.5">
      <p class="text-[9.5px] uppercase tracking-[0.08em] text-fg-subtle font-head">Pages written</p>
      {results.map((r, i) => (
        <div class="mock-step flex items-center gap-2" style={`--step: ${i + 2}`}>
          <span
            class:list={[
              'grid h-4 w-4 shrink-0 place-items-center rounded-full',
              r.state === 'done' ? 'bg-ok-soft text-ok' : 'bg-surface-2 text-fg-subtle',
            ]}
            aria-hidden="true"
          >
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={r.state === 'done' ? checkIcon : dashIcon} />
            </svg>
          </span>
          <span class:list={['text-[11px]', r.state === 'done' ? 'text-fg' : 'text-fg-subtle']}>{r.code}</span>
          <span class="text-[10.5px] text-fg-subtle">{r.state === 'done' ? 'Static page updated' : 'Not available — skipped'}</span>
        </div>
      ))}
    </div>
  </div>
</MockFrame>

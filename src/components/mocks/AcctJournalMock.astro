---
import MockFrame from './MockFrame.astro';
// Closed beta: this line's account came from a rule, not a person, so it
// carries "Unreviewed rule" until an accountant validates the mapping —
// nothing here is posted without that check existing.
type Line = { code: string; name: string; dr: string; cr: string; selected?: boolean; unreviewed?: boolean };
const lines: Line[] = [
  { code: '6100', name: 'Office supplies', dr: '60.00', cr: '', selected: true, unreviewed: true },
  { code: '6410', name: 'Travel', dr: '24.00', cr: '' },
  { code: '6540', name: 'Software', dr: '12.00', cr: '' },
  { code: '6420', name: 'Postage', dr: '8.00', cr: '' },
  { code: '2100', name: 'Accounts payable', dr: '', cr: '104.00' },
];
---
<MockFrame chrome="panel" title="Bookkeeping — Entry" meta="Balanced">
  <div class="space-y-2">
    <div class="grid grid-cols-[30px_1fr_46px_46px] items-center gap-2 border-b border-line px-1.5 pb-1.5">
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Code</span>
      <span class="font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Account</span>
      <span class="text-right font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Dr</span>
      <span class="text-right font-head text-[9.5px] font-semibold uppercase tracking-[0.1em] text-fg-subtle">Cr</span>
    </div>
    {lines.map((l) => (
      <div
        class:list={[
          'rounded-md border px-1.5 py-1',
          l.selected ? 'border-action/35 bg-surface-2' : 'border-line bg-surface',
        ]}
      >
        <div class="grid grid-cols-[30px_1fr_46px_46px] items-center gap-2">
          <span class="text-[10.5px] tabular-nums text-fg-subtle">{l.code}</span>
          <span class="truncate text-[12px] text-fg">{l.name}</span>
          <span class="text-right text-[12px] tabular-nums text-fg">{l.dr || '–'}</span>
          <span class="text-right text-[12px] tabular-nums text-fg">{l.cr || '–'}</span>
        </div>
        {l.unreviewed && (
          <div class="mt-1 flex justify-end">
            <span class="shrink-0 whitespace-nowrap rounded-full bg-warn-soft px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em] text-warn">Unreviewed rule</span>
          </div>
        )}
      </div>
    ))}
    <div class="grid grid-cols-[30px_1fr_46px_46px] items-center gap-2 border-t border-line px-1.5 pt-1.5">
      <span class="col-span-2 font-head text-[9.5px] font-semibold uppercase tracking-[0.08em] text-fg">Total</span>
      <span class="text-right font-head text-[12px] font-semibold tabular-nums text-action">104.00</span>
      <span class="text-right font-head text-[12px] font-semibold tabular-nums text-action">104.00</span>
    </div>

    <div class="flex items-center gap-1.5 border-t border-line pt-2">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-fg-subtle" aria-hidden="true">
        <path d="M7 3v14M3 7l4-4 4 4" /><path d="M17 21V7m-4 10 4 4 4-4" />
      </svg>
      <p class="text-[10.5px] text-fg-subtle">
        Document <span class="font-medium tabular-nums text-fg">SGD 104.00</span> · Booked <span class="font-medium tabular-nums text-fg">USD 76.76</span>
      </p>
    </div>
  </div>
</MockFrame>

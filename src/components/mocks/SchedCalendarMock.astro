---
import MockFrame from './MockFrame.astro';
// A provider's day, dense enough to show why cooldowns matter: the conflict
// check spans a service plus its cooldown, which is what keeps two bookings
// from sitting back-to-back — the dashed blocks are that reserved gap, not
// dead space. Confirmed vs needs-confirm mirrors the per-service
// auto-confirm setting: quick, standard services confirm on their own; the
// initial consult and the custom package need the provider to accept. The
// two shortest blocks skip the pill — there isn't room to render one legibly.
const hours = ['9', '10', '11', '12', '13', '14', '15'];
const rowHeight = 28;
type Confirm = 'auto' | 'manual';
const bookings: { top: number; height: number; label: string; confirm?: Confirm; current?: boolean }[] = [
  { top: 0, height: 42, label: '9:00–10:30 · Colour', confirm: 'auto' },
  { top: 56, height: 28, label: '11:00–12:00 · Consult', confirm: 'manual' },
  { top: 98, height: 21, label: '12:30–13:15 · Cut & style' },
  { top: 126, height: 42, label: '13:30–15:00 · Massage + facial package', confirm: 'manual', current: true },
  { top: 182, height: 14, label: '15:30–16:00 · Manicure' },
];
const turnarounds = [
  { top: 42, height: 14 },
  { top: 84, height: 14 },
  { top: 119, height: 7 },
  { top: 168, height: 14 },
];
---
<MockFrame chrome="panel" title="Booking — Provider day" meta="5 booked">
  <div class="flex gap-2">
    <div class="flex flex-col">
      {hours.map((h) => (
        <div class="h-7 shrink-0 text-right text-[9.5px] tabular-nums text-fg-subtle">{h}</div>
      ))}
    </div>
    <div class="relative flex-1 border-l border-line" style={`height:${hours.length * rowHeight}px`}>
      <div class="flex flex-col">
        {hours.map((_, i) => (
          <div class:list={['h-7', i < hours.length - 1 ? 'border-b border-line' : '']}></div>
        ))}
      </div>
      <div class="absolute inset-0">
        {turnarounds.map((t) => (
          <div
            class="absolute left-1 right-1 rounded-sm border border-dashed border-line bg-fg-subtle/10"
            style={`top:${t.top}px; height:${t.height}px`}
          ></div>
        ))}
        {bookings.map((b) => (
          <div
            class:list={[
              'absolute left-1 right-1 overflow-hidden rounded-md border',
              b.current ? 'border-action/60 bg-action/20' : 'border-line bg-action/10',
            ]}
            style={`top:${b.top}px; height:${b.height}px`}
          >
            <div class="flex h-full items-center gap-1 px-1.5">
              {b.confirm && (
                <span
                  class:list={[
                    'shrink-0 whitespace-nowrap rounded-full px-1.5 py-px font-head text-[9.5px] font-semibold uppercase tracking-[0.06em]',
                    b.confirm === 'auto' ? 'bg-ok-soft text-ok' : 'bg-warn-soft text-warn',
                  ]}
                >
                  {b.confirm === 'auto' ? 'Confirmed' : 'Needs confirm'}
                </span>
              )}
              <span class="truncate text-[9.5px] font-medium leading-tight tabular-nums text-fg">{b.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</MockFrame>

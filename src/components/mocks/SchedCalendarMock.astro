---
import MockFrame from './MockFrame.astro';
const hours = ['9', '10', '11', '12', '13', '14', '15'];
const rowHeight = 28;
const bookings = [
  { top: 0, height: 42, label: '9:00–10:30 · Colour' },
  { top: 70, height: 28, label: '11:00–12:00 · Consult' },
  { top: 126, height: 56, label: '13:00–15:00 · Massage' },
];
const turnaround = { top: 42, height: 14 };
---
<MockFrame title="Booking — Provider day" meta="3 booked">
  <div class="flex gap-2">
    <div class="flex flex-col">
      {hours.map((h) => (
        <div class="h-7 shrink-0 text-right text-[9px] text-fg-subtle">{h}</div>
      ))}
    </div>
    <div class="relative flex-1 border-l border-line" style={`height:${hours.length * rowHeight}px`}>
      <div class="flex flex-col">
        {hours.map((_, i) => (
          <div class:list={['h-7', i < hours.length - 1 ? 'border-b border-line' : '']}></div>
        ))}
      </div>
      <div class="absolute inset-0">
        <div
          class="absolute left-1 right-1 rounded-sm border border-dashed border-line bg-fg-subtle/10"
          style={`top:${turnaround.top}px; height:${turnaround.height}px`}
        ></div>
        {bookings.map((b) => (
          <div
            class="absolute left-1 right-1 overflow-hidden rounded-md border border-line bg-action/10"
            style={`top:${b.top}px; height:${b.height}px`}
          >
            <span class="block truncate px-1.5 py-1 text-[9px] font-medium leading-tight text-fg">{b.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</MockFrame>

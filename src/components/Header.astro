---
import { site } from '../content/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---

<header
  id="site-header"
  class="sticky top-0 z-[100] border-b border-line bg-bg/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-[76px] max-w-[1180px] items-center gap-7 px-6">
    <a href="/" aria-label={`${site.name} home`} class="mr-auto flex items-center gap-2.5">
      <img src="/img/logo-mark.svg" alt="" width="41" height="30" class="h-[30px] w-auto" />
      <img src="/img/logo-wordmark-white.svg" alt={site.name} data-logo="light" class="h-4 w-auto" />
      <img src="/img/logo-wordmark-ink.svg" alt={site.name} data-logo="dark" class="h-4 w-auto" />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {site.nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'font-head text-sm font-medium transition-colors duration-200 hover:text-fg',
            isActive(item.href) ? 'text-fg' : 'text-fg-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      id="themeToggle"
      type="button"
      aria-label="Switch theme"
      class="flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-[10px] border border-line text-fg-muted transition-colors duration-200 hover:border-action hover:text-fg"
    >
      <!-- Sun shows on dark (click for light); moon shows on light. -->
      <svg data-logo="light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg data-logo="dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>

    <a
      href="/contact/"
      class="hidden min-h-[40px] cursor-pointer items-center rounded-full bg-action px-5 py-2.5 font-head text-sm font-semibold text-on-action transition-transform duration-200 hover:-translate-y-0.5 lg:inline-flex"
    >
      Talk to us
    </a>

    <button
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobileNav"
      aria-label="Open menu"
      class="flex h-11 w-11 shrink-0 cursor-pointer flex-col items-center justify-center gap-[5px] rounded-[10px] border border-line lg:hidden"
    >
      <span class="block h-0.5 w-[18px] bg-fg transition-transform duration-200"></span>
      <span class="block h-0.5 w-[18px] bg-fg transition-opacity duration-200"></span>
      <span class="block h-0.5 w-[18px] bg-fg transition-transform duration-200"></span>
    </button>
  </div>

  <div id="mobileNav" class="hidden flex-col gap-1 border-t border-line px-6 pb-6 pt-2.5 lg:hidden">
    {site.nav.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={[
          'flex min-h-[44px] items-center border-b border-line py-3.5 font-head font-medium',
          isActive(item.href) ? 'text-fg' : 'text-fg-muted',
        ]}
      >
        {item.label}
      </a>
    ))}
    <a
      href="/contact/"
      class="mt-3.5 inline-flex min-h-[44px] w-full cursor-pointer items-center justify-center rounded-full bg-action px-6 py-3.5 font-head font-semibold text-on-action"
    >
      Talk to us
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const mobileNav = document.getElementById('mobileNav');

  function setOpen(open: boolean) {
    if (!toggle || !mobileNav) return;
    mobileNav.classList.toggle('hidden', !open);
    mobileNav.classList.toggle('flex', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    const [a, b, c] = Array.from(toggle.querySelectorAll('span'));
    a.style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
    b.style.opacity = open ? '0' : '';
    c.style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>

---
import { withBase } from '../base';
import { site } from '../content/site';
import ThemeSet from './ThemeSet.astro';

const path = Astro.url.pathname;
// Nav hrefs are base-less; the page path carries the base, so compare against
// withBase(href) or nothing ever matches on the project-page deploy.
const isActive = (href: string) => {
  const full = withBase(href);
  return path === full || path.startsWith(full.replace(/\/$/, '') + '/');
};
// On the home page the bar starts out sitting on the hero's ground, with no
// border, and turns frosted once the hero scrolls away (founder, 2026-10-04).
const onHome = path === withBase('/');
---

<header
  id="site-header"
  class="site-header sticky top-0 z-[100] border-b"
  data-over-hero={onHome ? '' : undefined}
>
  <div class="mx-auto flex h-[76px] max-w-[1180px] items-center gap-3 px-6 sm:gap-5 lg:gap-7">
    <a href={withBase("/")} aria-label={`${site.name} home`} class="mr-auto flex items-center gap-2 sm:gap-2.5">
      <img src={withBase("/img/logo-mark.svg")} alt="" width="41" height="30" class="h-6 w-auto sm:h-[30px]" />
      <img src={withBase("/img/logo-wordmark-white.svg")} alt={site.name} data-logo="light" class="h-3 w-auto sm:h-4" />
      <img src={withBase("/img/logo-wordmark-ink.svg")} alt={site.name} data-logo="dark" class="h-3 w-auto sm:h-4" />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {site.nav.map((item, i) => (
        <a
          href={withBase(item.href)}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'nav-link relative py-2 font-head text-sm font-medium transition-colors duration-200 hover:text-fg',
            isActive(item.href) || i === site.nav.length - 1 ? 'text-fg' : 'text-fg-muted',
          ]}
        >
          {item.label}
          {i === site.nav.length - 1 && <span class="nav-arrow ml-1 inline-block text-accent" aria-hidden="true" />}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <span class="h-[18px] w-px bg-line" aria-hidden="true"></span>
      <button
        type="button"
        data-theme-toggle
        aria-label="Switch theme"
        class="flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center rounded-full text-fg-muted transition duration-200 hover:bg-fg/5 hover:text-fg active:scale-[.92]"
      >
        <!-- Sun shows on dark (click for light); moon shows on light. -->
        <svg data-logo="light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg data-logo="dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      </button>
    </div>

    <button
      id="navToggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobileNav"
      aria-label="Open menu"
      class="flex h-11 w-11 shrink-0 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-full transition duration-200 hover:bg-fg/5 active:scale-[.92] lg:hidden"
    >
      <span class="menu-bar block h-0.5 w-[18px] bg-fg"></span>
      <span class="menu-bar block h-0.5 w-[18px] bg-fg"></span>
    </button>
  </div>
</header>

<!-- Outside the header on purpose: the header's backdrop-filter makes it the
     containing block for fixed children, which would clip this to the bar. -->
<div id="mobileNav" class="menu-panel fixed inset-0 z-[90] overflow-y-auto lg:hidden" inert>
  <div class="flex min-h-full flex-col justify-between px-6 pb-8 pt-[108px]">
    <nav aria-label="Menu">
      <ul>
        {site.nav.map((item, i) => (
          <li data-stagger style={`--i:${i}`}>
            <a
              href={withBase(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="menu-link flex items-baseline gap-4 py-3 font-head text-[40px] font-bold leading-tight text-white"
            >
              <span class="font-mono text-[12px] font-normal text-white/60" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="mt-12 flex flex-col gap-6">
      <div data-stagger style={`--i:${site.nav.length}`}>
        <p class="text-[15px] text-white/70">Email us what you are trying to fix.</p>
        <a href={`mailto:${site.email}`} class="mt-1 inline-block break-all font-head text-[17px] font-semibold text-white underline decoration-white/30 underline-offset-4">{site.email}</a>
      </div>
      <div data-stagger style={`--i:${site.nav.length + 1}`}>
        <ThemeSet tone="navy" />
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    background: color-mix(in srgb, var(--color-bg) 80%, transparent);
    border-bottom-color: var(--color-line);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: background-color 300ms var(--ease-brand), border-color 300ms var(--ease-brand);
  }
  /* The home hero runs up under the bar (MockWall pulls itself up by the bar's
     height), so over it the bar is fully see-through. */
  .site-header[data-over-hero] {
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  /* An open phone menu: the bar goes clear over the navy panel and its logo
     and button turn white, in both themes (the panel is navy in both). */
  .site-header[data-menu-open] {
    background: transparent;
    border-bottom-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .site-header[data-menu-open] img[data-logo="light"] { display: block; }
  .site-header[data-menu-open] img[data-logo="dark"] { display: none; }
  .site-header[data-menu-open] .menu-bar { background: white; }
  .site-header[data-menu-open] #navToggle:hover { background: color-mix(in srgb, white 10%, transparent); }

  .menu-bar { transition: transform 300ms var(--ease-brand); }
  .site-header[data-menu-open] .menu-bar:first-child { transform: translateY(4px) rotate(45deg); }
  .site-header[data-menu-open] .menu-bar:last-child { transform: translateY(-4px) rotate(-45deg); }

  /* Desktop nav: a cyan line draws in from the left on hover and leaves to the
     right (the origin swap); the current page carries a small glowing dot. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3px;
    height: 2px;
    background: var(--color-cyan);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 450ms var(--ease-brand);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(100% + 4px);
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--color-cyan) 70%, transparent);
  }
  .nav-arrow::before { content: '\2192'; }
  .nav-arrow { transition: transform 300ms var(--ease-brand); }
  .nav-link:hover .nav-arrow { transform: translateX(4px); }

  /* Phone panel: deep navy in both themes, revealed as a circle that grows from
     the menu button (--ox/--oy are set from the button's position on open). */
  .menu-panel {
    background:
      radial-gradient(520px 460px at 100% 0%, color-mix(in srgb, var(--color-cyan) 18%, transparent), transparent 70%),
      var(--color-navy-deep);
    clip-path: circle(0px at var(--ox, 90%) var(--oy, 38px));
    visibility: hidden;
    transition: clip-path 700ms var(--ease-brand), visibility 0s linear 700ms;
  }
  .menu-panel[data-open] {
    clip-path: circle(160vmax at var(--ox, 90%) var(--oy, 38px));
    visibility: visible;
    transition-delay: 0s;
  }
  .menu-panel [data-stagger] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 500ms var(--ease-brand), transform 500ms var(--ease-brand);
  }
  .menu-panel[data-open] [data-stagger] {
    opacity: 1;
    transform: none;
    transition-delay: calc(240ms + var(--i) * 70ms);
  }
  .menu-link:focus-visible { outline-color: white; }
  .menu-panel :focus-visible { outline-color: white; }
  @media (prefers-reduced-motion: reduce) {
    .menu-panel, .menu-panel[data-open], .menu-panel [data-stagger], .menu-bar, .nav-link::after, .nav-arrow { transition: none; }
    .menu-panel [data-stagger] { opacity: 1; transform: none; }
  }
</style>

<script>
  // Home only: stay on the hero's ground until the hero has scrolled under
  // the bar, then turn frosted. Other pages keep the frosted bar throughout.
  const header = document.getElementById('site-header');
  const hero = document.querySelector<HTMLElement>('.wall');
  if (header && hero) {
    let frame = 0;
    const update = () => {
      frame = 0;
      header.toggleAttribute('data-over-hero', hero.getBoundingClientRect().bottom > header.offsetHeight + 40);
    };
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(update); }, { passive: true });
    update();
  }

  const toggle = document.getElementById('navToggle');
  const panel = document.getElementById('mobileNav');

  function setOpen(open: boolean, returnFocus = false) {
    if (!toggle || !panel) return;
    if (open) {
      const r = toggle.getBoundingClientRect();
      panel.style.setProperty('--ox', `${r.left + r.width / 2}px`);
      panel.style.setProperty('--oy', `${r.top + r.height / 2}px`);
    }
    panel.toggleAttribute('data-open', open);
    panel.inert = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header?.toggleAttribute('data-menu-open', open);
    // Keep Tab and the page behind out of reach while the panel is up.
    document.querySelectorAll('main, footer').forEach((el) => ((el as HTMLElement).inert = open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    else if (returnFocus) toggle.focus();
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true', true);
  });
  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false, true);
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

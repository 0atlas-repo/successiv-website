---
import { products } from '../content/products';
import ProductCard from './ProductCard.astro';
import SectionHead from './SectionHead.astro';

interface Props { kicker?: string; title?: string; lede?: string }
const {
  kicker = '01 — Products',
  title = 'Four products we build and operate.',
  lede = 'Built for work that used to stall in chat, email, and spreadsheets — storefront answers, creator campaigns, identity packs, and bills.',
} = Astro.props;
---
<section id="products" class="py-[100px]">
  <div class="mx-auto max-w-[1180px] px-6">
    <SectionHead kicker={kicker} title={title} lede={lede} />
    <!-- Two columns all the way up: with four products, a third column leaves one
         card stranded on its own row. Restore xl:grid-cols-3 if a fifth ships. -->
    <div class="grid gap-6 md:grid-cols-2">
      {products.map((p, i) => <ProductCard product={p} index={i} />)}
    </div>
  </div>
</section>

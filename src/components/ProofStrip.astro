---
import { withBase } from '../base';
import { capabilities } from '../content/capabilities';

// The reference sites put a customer logo wall here. Client work is under NDA, so
// the honest equivalent is the capability set itself — same bordered-cell grid,
// no invented logos, no invented metrics.
//
// Seven capabilities divide into neither two nor four columns, so the last cell
// spans two and closes the row. Revisit if the count becomes even again.
---
<section class="border-b border-line bg-surface/40">
  <div class="mx-auto max-w-[1180px] px-6 pt-12 pb-9">
    <p class="reveal text-center font-head text-[12px] font-semibold uppercase tracking-[0.14em] text-fg-subtle">
      What you get out of working with us
    </p>
  </div>
  <div class="mx-auto grid max-w-[1180px] grid-cols-2 border-t border-line sm:grid-cols-4">
    {capabilities.map((c) => (
      <a
        href={withBase("/capabilities/")}
        class="group flex min-h-[104px] cursor-pointer flex-col justify-between border-b border-r border-line p-5 transition-colors duration-300 last:col-span-2 last:border-r-0 hover:bg-surface"
      >
        <span class="font-head text-[11px] font-semibold tracking-[0.08em] text-fg-subtle">{c.num}</span>
        <span class="mt-3 font-head text-[13px] font-medium leading-snug text-fg-muted transition-colors duration-300 group-hover:text-fg">
          {c.title}
        </span>
      </a>
    ))}
  </div>
</section>

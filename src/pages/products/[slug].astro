---
import { withBase } from '../../base';
import Layout from '../../layouts/Layout.astro';
import Btn from '../../components/Btn.astro';
import ProductMock from '../../components/mocks/ProductMock.astro';
import CTA from '../../components/CTA.astro';
import { products, type Product } from '../../content/products';
import { site } from '../../content/site';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props { product: Product }
const { product } = Astro.props;

const others = products.filter((p) => p.slug !== product.slug);
const restScreens = product.screens.slice(1);
// When every step draws its own screen, the gallery would only repeat them.
const stepsCarryScreens = product.steps.every((s) => s.screen);
---
<Layout
  title={product.name}
  description={product.needsCopy ? product.oneLiner : `${product.oneLiner} ${product.problem}`}
  noindex={product.needsCopy}
>
  <!-- Intro: claim on the left, the product screen on the right. -->
  <section class="hero-wash border-b border-line pb-20 pt-[88px]">
    <div class="mx-auto max-w-[1180px] px-6">
      <div class="grid items-center gap-14 lg:grid-cols-[1fr_0.9fr]">
        <div>
          <p class="reveal mb-5 font-head text-[13px] font-semibold uppercase tracking-[0.14em] text-accent">
            {product.category}
          </p>
          <h1 class="reveal text-[clamp(34px,5vw,56px)] text-fg">{product.name}</h1>
          <p class="reveal mt-4 max-w-[540px] text-[clamp(18px,2vw,21px)] text-fg-muted">{product.oneLiner}</p>

          {product.needsCopy && (
            <p class="reveal mt-5 max-w-[540px] rounded-[12px] border border-dashed border-line px-4 py-3 text-[14px] text-fg-subtle">
              This page is a placeholder. We have not published a description of this product yet,
              so nothing here claims what it does.
            </p>
          )}

          {product.preRelease && (
            <p class="reveal mt-5 max-w-[540px] rounded-[12px] border border-dashed border-line px-4 py-3 text-[14px] text-fg-subtle">
              Not released yet. Everything described here is built and running in closed beta —
              we have not set a launch date, so we are not claiming one.
            </p>
          )}

          <div class="reveal mt-8 flex flex-wrap gap-4">
            <Btn href={`mailto:${site.email}`}>{product.cta}</Btn>
            {product.url ? (
              <Btn href={product.url} variant="ghost">
                Visit the site
                <span aria-hidden="true">&#8599;</span>
              </Btn>
            ) : (
              <Btn href={withBase("/products/")} variant="ghost">All products</Btn>
            )}
          </div>
        </div>

        <div class="reveal relative max-lg:mx-auto max-lg:max-w-[420px]">
          <div class="mock-wash pointer-events-none absolute -inset-10" aria-hidden="true"></div>
          <div class="relative lg:rotate-[1.2deg]"><ProductMock mock={product.screens[0]} /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="py-[90px]">
    <div class="mx-auto grid max-w-[1180px] grid-cols-1 gap-10 px-6 md:grid-cols-[260px_1fr]">
      <div class="reveal">
        <span class="font-head text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">The problem</span>
      </div>
      <p class="reveal max-w-[720px] font-head text-[clamp(20px,2.6vw,28px)] font-medium leading-[1.4] text-fg">
        {product.problem}
      </p>
    </div>
  </section>

  <!-- The short answer to the problem, where a product has one (2026-09-24). -->
  {product.solution && (
    <section class="border-t border-line py-[90px]">
      <div class="mx-auto grid max-w-[1180px] grid-cols-1 gap-10 px-6 md:grid-cols-[260px_1fr]">
        <div class="reveal">
          <span class="font-head text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">Our solution</span>
        </div>
        <p class="reveal max-w-[720px] font-head text-[clamp(20px,2.6vw,28px)] font-medium leading-[1.4] text-fg">
          {product.solution}
        </p>
      </div>
    </section>
  )}

  <!-- The long form. Absent by design on a placeholder page. -->
  {!product.solution && product.detail.length > 0 && (
    <section class="border-t border-line py-[90px]">
      <div class="mx-auto grid max-w-[1180px] grid-cols-1 gap-10 px-6 md:grid-cols-[260px_1fr]">
        <div class="reveal">
          <span class="font-head text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">
            What it actually does
          </span>
        </div>
        <div class="reveal max-w-[720px] space-y-6">
          {product.detail.map((para) => (
            <p class="text-[16px] leading-[1.7] text-fg-muted">{para}</p>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Remaining screens. -->
  {!stepsCarryScreens && restScreens.length > 0 && (
    <section class="border-t border-line py-[90px]">
      <div class="mx-auto max-w-[1180px] px-6">
        <div class="reveal mb-10 max-w-[640px]">
          <span class="mb-4 inline-block font-head text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">
            Screens
          </span>
          <h2 class="text-[clamp(28px,4vw,40px)] text-fg">Drawn, not screenshotted.</h2>
          <p class="mt-3 text-[15px] text-fg-muted">
            Illustrations of the product. No customer data.
          </p>
        </div>

        <div
          class:list={[
            'grid gap-8',
            restScreens.length > 1 ? 'sm:grid-cols-2' : 'max-w-[520px]',
          ]}
        >
          {restScreens.map((screen) => (
            <div class="reveal relative">
              <div class="mock-wash pointer-events-none absolute -inset-6" aria-hidden="true"></div>
              <div class="relative"><ProductMock mock={screen} /></div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- How it works: editorial rows, the direction chosen in the previews exercise. -->
  <section class="border-t border-line py-[90px]">
    <div class="mx-auto max-w-[1180px] px-6">
      <div class="reveal mb-10 max-w-[640px]">
        <span class="mb-4 inline-block font-head text-[13px] font-semibold uppercase tracking-[0.12em] text-accent">
          How it works
        </span>
        <h2 class="text-[clamp(28px,4vw,40px)] text-fg">{product.steps.length} steps, start to finish.</h2>
      </div>

      <div class="border-t border-line">
        {product.steps.map((step, i) => (
          // A step with its own screen: text and screen side by side, sides alternating.
          step.screen ? (
            <article class="reveal grid items-center gap-8 border-b border-line py-[48px] lg:grid-cols-2 lg:gap-14">
              <div class:list={['grid grid-cols-[40px_1fr] items-baseline gap-4 sm:grid-cols-[64px_1fr] sm:gap-6', i % 2 === 1 && 'lg:order-2']}>
                <span class="font-head text-[15px] font-bold text-accent">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="mb-1.5 font-head text-[20px] font-semibold text-fg">{step.title}</h3>
                  <p class="max-w-[520px] text-[15px] text-fg-muted">{step.body}</p>
                </div>
              </div>
              <div class="relative mx-auto w-full max-w-[460px]">
                <div class="mock-wash pointer-events-none absolute -inset-6" aria-hidden="true"></div>
                <div class="relative"><ProductMock mock={step.screen} /></div>
              </div>
            </article>
          ) : (
            <article class="reveal grid grid-cols-[40px_1fr] items-baseline gap-4 border-b border-line py-[30px] sm:grid-cols-[64px_1fr] sm:gap-6">
              <span class="font-head text-[15px] font-bold text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="mb-1.5 font-head text-[20px] font-semibold text-fg">{step.title}</h3>
                <p class="max-w-[640px] text-[15px] text-fg-muted">{step.body}</p>
              </div>
            </article>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- Other products -->
  <section class="border-t border-line py-[90px]">
    <div class="mx-auto max-w-[1180px] px-6">
      <h2 class="reveal mb-8 font-head text-[22px] font-semibold text-fg">Other products</h2>
      <div class="flex flex-wrap gap-3">
        {others.map((p) => (
          <a
            href={withBase(`/products/${p.slug}/`)}
            class="reveal cursor-pointer rounded-full border border-line px-5 py-2.5 font-head text-[14px] font-medium text-fg-muted transition-all duration-200 hover:-translate-y-0.5 hover:border-action hover:text-accent"
          >
            {p.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTA
    kicker="Next step"
    title={`Want to see ${product.name} against your own setup?`}
    lede="Email a short note on how you work today. We will show the parts that matter."
  />
</Layout>

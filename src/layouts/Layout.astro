---
import { withBase } from '../base';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '../styles/global.css';
import { site } from '../content/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep placeholder pages out of search results until their copy is real. */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

// Every page states its own title. Only the home page uses the bare brand name.
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/img/og-placeholder.png', Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- Placeholder OG image. Replace public/img/og-placeholder.png with real artwork. -->
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Light is the default surface, dark is offered. Tell the browser both
         exist so form controls and scrollbars match. -->
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/img/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase("/img/favicon-16.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/img/favicon-180.png")} />

    <noscript>
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>

    <!-- Applies the saved theme before first paint, so there is no flash of the
         wrong theme. Storage throws in some privacy modes — swallow and fall
         back to the system preference. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('successiv-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* no stored preference available; CSS falls back to the system setting */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-[200] focus:rounded-br-lg focus:bg-action focus:px-5 focus:py-3 focus:font-semibold focus:text-on-action"
    >
      Skip to main content
    </a>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal on scroll.
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window && revealEls.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el, i) => {
          el.style.transitionDelay = `${Math.min(i % 4, 3) * 70}ms`;
          observer.observe(el);
        });
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // Theme controls. The <head> script has already applied any saved choice;
      // this handles clicks and keeps labels and pressed states honest.
      //   [data-theme-toggle]            flips light <-> dark
      //   [data-theme-set=light|dark|auto]  sets that mode; auto forgets the
      //                                  saved choice so CSS follows the OS again
      const root = document.documentElement;
      const KEY = 'successiv-theme';

      function currentTheme(): 'light' | 'dark' {
        const explicit = root.getAttribute('data-theme');
        if (explicit === 'light' || explicit === 'dark') return explicit;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }

      function saved(): string | null {
        try {
          return localStorage.getItem(KEY);
        } catch (e) {
          return null;
        }
      }

      function syncControls() {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
          el.setAttribute('aria-label', `Switch to ${next} theme`);
          el.setAttribute('title', `Switch to ${next} theme`);
        });
        const mode = saved() === 'light' || saved() === 'dark' ? saved() : 'auto';
        document.querySelectorAll('[data-theme-set]').forEach((el) => {
          el.setAttribute('aria-pressed', String(el.getAttribute('data-theme-set') === mode));
        });
      }

      function apply(mode: string) {
        if (mode === 'auto') {
          root.removeAttribute('data-theme');
        } else {
          root.setAttribute('data-theme', mode);
        }
        try {
          if (mode === 'auto') localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, mode);
        } catch (e) {
          /* preference just will not persist; the page still switches */
        }
        syncControls();
      }

      // Switching freezes motion, then fades colours to the new theme; the
      // wall's runway dims across the change instead (founder, 2026-10-05).
      // It replaced a circle wash whose page snapshot made the drifting wall
      // jump and snap back. Timings match global.css.
      let timers: number[] = [];
      function change(mode: string) {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          apply(mode);
          return;
        }
        timers.forEach(clearTimeout);
        root.classList.add('theme-switching', 'theme-dim');
        timers = [
          window.setTimeout(() => apply(mode), 180),
          window.setTimeout(() => root.classList.remove('theme-dim'), 260),
          window.setTimeout(() => root.classList.remove('theme-switching'), 700),
        ];
      }

      document.querySelectorAll('[data-theme-toggle]').forEach((el) => {
        el.addEventListener('click', () => change(currentTheme() === 'dark' ? 'light' : 'dark'));
      });
      document.querySelectorAll('[data-theme-set]').forEach((el) => {
        el.addEventListener('click', () => change(el.getAttribute('data-theme-set') ?? 'auto'));
      });

      // If the visitor has never chosen, follow the system when it changes.
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (!saved()) syncControls();
      });

      syncControls();
    </script>
  </body>
</html>
